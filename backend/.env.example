NODE_ENV=production
PORT=3001
FRONTEND_URL=https://scripthive.org
DATABASE_URL=postgresql://user:password@localhost:5432/scripthive_db
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Brevo SMTP example:
# SMTP_HOST=smtp-relay.brevo.com
SMTP_HOST=mail.scripthive.org
SMTP_PORT=587
SMTP_USER=article@scripthive.org
SMTP_PASS=your_smtp_password
SMTP_FROM=ScriptHive Publication  <article@scripthive.org>
ADMIN_EMAIL=info@scripthive.org
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=live
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
DOI_PREFIX=10.55662
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
