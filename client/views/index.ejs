<%- include('partials/header') %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1e40af;
      --navy: #0f172a;
      --gold: #fbbf24;
      --gold-light: #fef08a;
      --bg-light: #f8fafc;
      --text-dark: #1e293b;
      --text-muted: #64748b;
      --glass-bg: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(255, 255, 255, 0.5);
      --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }

    body {
      background-color: var(--bg-light);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Utility Classes */
    .section-padding {
      padding: 100px 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .section-title {
      font-size: 3rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 20px;
      text-align: center;
      line-height: 1.2;
    }

    .section-title.light {
      color: white;
    }

    .section-subtitle {
      font-size: 1.2rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 800px;
      margin: 0 auto 50px;
      text-align: center;
    }

    .section-subtitle.light {
      color: #cbd5e1;
    }

    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      box-shadow: var(--glass-shadow);
      padding: 40px;
      transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      border-color: rgba(37, 99, 235, 0.3);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 15px 30px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      transition: 0.3s;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: white;
      box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(37, 99, 235, 0.4);
      color: white;
    }

    .btn-white {
      background: white;
      color: var(--primary);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .btn-white:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    }

    .btn-outline-white {
      border: 2px solid white;
      color: white;
      background: transparent;
    }

    .btn-outline-white:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
      transform: translateY(-3px);
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      background: var(--navy);
      color: white;
      padding: 180px 20px 150px;
      overflow: hidden;
      min-height: 90vh;
      display: flex;
      align-items: center;
    }

    .hero-mesh {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: radial-gradient(circle at 20% 40%, rgba(37, 99, 235, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(251, 191, 36, 0.15) 0%, transparent 50%);
      animation: meshPulse 10s infinite alternate ease-in-out;
    }

    @keyframes meshPulse {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }

      100% {
        transform: scale(1.1);
        opacity: 1;
      }
    }

    .hero-particles {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.3;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
      align-items: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 0.9rem;
      margin-bottom: 25px;
      backdrop-filter: blur(10px);
      color: var(--gold-light);
      font-weight: 600;
    }

    .hero-title {
      font-size: 4.5rem;
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 25px;
      background: linear-gradient(135deg, #fff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-title em {
      font-style: normal;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 40px;
      font-weight: 400;
      max-width: 600px;
    }

    .hero-buttons {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    /* Hero Visual 3D */
    .hero-visual {
      position: relative;
      height: 500px;
      perspective: 1000px;
    }

    .hero-floating-card {
      position: absolute;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    }

    .hc-main {
      width: 320px;
      top: 50px;
      left: 50px;
      z-index: 2;
      animation: floatObj 6s infinite alternate ease-in-out;
      border-top: 4px solid var(--primary);
    }

    .hc-small-1 {
      width: 200px;
      top: -10px;
      right: 20px;
      z-index: 1;
      animation: floatObj 5s infinite alternate-reverse ease-in-out;
      background: rgba(37, 99, 235, 0.1);
      border-color: rgba(37, 99, 235, 0.3);
    }

    .hc-small-2 {
      width: 220px;
      bottom: 40px;
      right: 40px;
      z-index: 3;
      animation: floatObj 7s infinite alternate ease-in-out;
      border-left: 4px solid var(--gold);
    }

    .mock-graph {
      height: 80px;
      display: flex;
      align-items: flex-end;
      gap: 8px;
      margin-top: 20px;
    }

    .mock-bar {
      background: var(--primary);
      width: 100%;
      border-radius: 4px;
      animation: barGrow 2s ease-out forwards;
    }

    .mock-bar:nth-child(1) {
      height: 40%;
      background: rgba(255, 255, 255, 0.2);
    }

    .mock-bar:nth-child(2) {
      height: 60%;
      background: rgba(255, 255, 255, 0.4);
    }

    .mock-bar:nth-child(3) {
      height: 100%;
      background: var(--gold);
    }

    @keyframes floatObj {
      0% {
        transform: translateY(0) rotateX(5deg) rotateY(-5deg);
      }

      100% {
        transform: translateY(-20px) rotateX(0deg) rotateY(0deg);
      }
    }

    @keyframes barGrow {
      0% {
        transform: scaleY(0);
        transform-origin: bottom;
      }

      100% {
        transform: scaleY(1);
        transform-origin: bottom;
      }
    }

    /* Stats Section */
    .stats-section {
      margin-top: -60px;
      position: relative;
      z-index: 10;
      padding: 0 20px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
      background: white;
      padding: 30px;
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--glass-border);
    }

    .stat-item {
      text-align: center;
      padding: 20px;
      border-right: 1px solid #e2e8f0;
      transition: 0.3s;
    }

    .stat-item:last-child {
      border-right: none;
    }

    .stat-item:hover {
      transform: translateY(-5px);
    }

    .stat-icon {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 15px;
    }

    .stat-title {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--text-dark);
      margin-bottom: 5px;
    }

    .stat-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* About Section */
    .about-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-content h2 {
      font-size: 3rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 25px;
      line-height: 1.2;
    }

    .about-content p {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .feature-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin: 30px 0;
    }

    .feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      color: var(--text-dark);
    }

    .feature-item i {
      color: #10b981;
      font-size: 1.2rem;
      background: rgba(16, 185, 129, 0.1);
      padding: 8px;
      border-radius: 50%;
    }

    .about-visual {
      position: relative;
      height: 500px;
    }

    .av-main {
      width: 100%;
      height: 100%;
      border-radius: 30px;
      object-fit: cover;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.1);
    }

    .av-card {
      position: absolute;
      bottom: 40px;
      left: -40px;
      background: white;
      padding: 25px;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      gap: 20px;
      animation: floatCard 4s infinite alternate;
      border: 1px solid var(--glass-border);
    }

    .av-card-icon {
      width: 60px;
      height: 60px;
      background: var(--primary);
      color: white;
      border-radius: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }

    @keyframes floatCard {
      0% {
        transform: translateY(0);
      }

      100% {
        transform: translateY(-15px);
      }
    }

    /* Mission & Vision */
    .mv-section {
      background: var(--navy);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .mv-mesh {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(37, 99, 235, 0.2) 0%, transparent 70%);
    }

    .mv-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .mv-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 50px;
      border-radius: 24px;
      position: relative;
      overflow: hidden;
      transition: 0.4s;
    }

    .mv-card:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateY(-10px);
      border-color: rgba(251, 191, 36, 0.3);
    }

    .mv-icon {
      font-size: 3rem;
      color: var(--gold);
      margin-bottom: 25px;
    }

    .mv-card h3 {
      font-size: 2.2rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .mv-card p {
      font-size: 1.15rem;
      color: #cbd5e1;
      line-height: 1.7;
    }

    /* Journals Showcase */
    .journals-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 30px;
    }

    .journal-card {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid var(--glass-border);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      transition: 0.4s;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .journal-card:hover {
      transform: translateY(-15px);
      box-shadow: 0 30px 60px rgba(37, 99, 235, 0.1);
      border-color: var(--primary);
    }

    .jc-header {
      padding: 30px;
      background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
      border-bottom: 1px solid #e2e8f0;
      position: relative;
    }



    .jc-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--navy);
      line-height: 1.4;
      margin-bottom: 5px;
      word-wrap: break-word;
    }

    .jc-acronym {
      font-size: 1.05rem;
      font-weight: 600;
      background: linear-gradient(135deg, var(--primary) 0%, var(--gold) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
      margin-left: 4px;
    }

    .jc-body {
      padding: 30px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .jc-desc {
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .jc-meta {
      display: flex;
      gap: 10px;
      margin-bottom: 25px;
      flex-wrap: wrap;
    }

    .meta-tag {
      background: #f1f5f9;
      color: var(--text-dark);
      padding: 5px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .meta-tag.oa {
      background: rgba(16, 185, 129, 0.1);
      color: #059669;
    }

    .jc-link {
      color: var(--primary);
      font-weight: 700;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: 0.3s;
    }

    .journal-card:hover .jc-link {
      gap: 10px;
    }

    /* Services Section */
    .services-section {
      background: var(--navy);
      color: white;
      position: relative;
    }

    .srv-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }

    .srv-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 35px;
      transition: 0.4s;
      backdrop-filter: blur(10px);
    }

    .srv-card:hover {
      transform: translateY(-10px);
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--primary);
    }

    .srv-icon {
      width: 60px;
      height: 60px;
      background: rgba(37, 99, 235, 0.2);
      color: var(--primary);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin-bottom: 20px;
      transition: 0.3s;
    }

    .srv-card:hover .srv-icon {
      background: var(--primary);
      color: white;
      transform: scale(1.1) rotate(5deg);
    }

    .srv-card h3 {
      font-size: 1.4rem;
      font-weight: 800;
      margin-bottom: 15px;
      color: white;
    }

    .srv-card p {
      color: #cbd5e1;
      line-height: 1.6;
    }

    /* CTA Section (Call for Papers) */
    .cta-section {
      padding: 120px 20px;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: white;
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .cta-content {
      max-width: 800px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .cta-content h2 {
      font-size: 3.5rem;
      font-weight: 900;
      margin-bottom: 25px;
    }

    .cta-content p {
      font-size: 1.25rem;
      margin-bottom: 40px;
      opacity: 0.9;
    }

    .cta-checklist {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 50px;
    }

    .cta-check-item {
      background: rgba(255, 255, 255, 0.1);
      padding: 10px 20px;
      border-radius: 30px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .cta-check-item i {
      color: var(--gold);
    }

    .cta-mesh {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 80% 20%, rgba(251, 191, 36, 0.3) 0%, transparent 60%);
      animation: meshPulse 8s infinite alternate;
    }

    /* Guidelines */
    .guide-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .guide-card {
      background: white;
      padding: 30px 20px;
      border-radius: 16px;
      text-align: center;
      border: 1px solid var(--glass-border);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.02);
      transition: 0.3s;
      position: relative;
      overflow: hidden;
    }

    .guide-card:hover {
      transform: translateY(-8px);
      border-color: var(--primary);
      box-shadow: 0 15px 30px rgba(37, 99, 235, 0.1);
    }

    .guide-num {
      font-size: 4rem;
      font-weight: 900;
      color: rgba(37, 99, 235, 0.05);
      position: absolute;
      top: -10px;
      right: -10px;
      line-height: 1;
      transition: 0.3s;
    }

    .guide-card:hover .guide-num {
      color: rgba(37, 99, 235, 0.1);
      transform: scale(1.1);
    }

    .guide-icon {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 15px;
      position: relative;
      z-index: 2;
    }

    .guide-title {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--text-dark);
      position: relative;
      z-index: 2;
    }

    .guide-featured {
      background: var(--bg-light);
      border: 1px solid var(--primary);
      border-radius: 24px;
      padding: 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
    }

    .gf-content h3 {
      font-size: 2rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 15px;
    }

    .gf-content p {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 600px;
    }

    /* Contact & Trust Grid */
    .ct-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .contact-box {
      background: white;
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--glass-border);
    }

    .cb-item {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
      padding-bottom: 25px;
      border-bottom: 1px solid #f1f5f9;
    }

    .cb-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .cb-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      background: rgba(37, 99, 235, 0.1);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .cb-item.whatsapp .cb-icon {
      background: rgba(37, 211, 102, 0.1);
      color: #25D366;
    }

    .cb-text h4 {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .cb-text p {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-dark);
      margin: 0;
    }

    .trust-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .trust-item {
      background: white;
      padding: 20px;
      border-radius: 16px;
      border: 1px solid var(--glass-border);
      display: flex;
      align-items: center;
      gap: 15px;
      font-weight: 600;
      color: var(--text-dark);
      transition: 0.3s;
    }

    .trust-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
      border-color: #10b981;
    }

    .trust-item i {
      color: #10b981;
      font-size: 1.2rem;
    }

    /* Responsive */
    @media (max-width: 1024px) {

      .hero-grid,
      .about-split,
      .mv-grid,
      .ct-grid {
        grid-template-columns: 1fr;
      }

      .hero-title {
        font-size: 3.5rem;
      }

      .stats-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
      }

      .stats-section {
        margin-top: 40px;
      }

      .hero-visual {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .guide-featured {
        flex-direction: column;
        text-align: center;
      }

      .trust-box {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .stats-grid {
        grid-template-columns: 1fr;
      }

      .hero-title {
        font-size: 2.5rem;
      }
    }
  </style>

