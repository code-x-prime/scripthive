  <!-- CAROUSEL STRIP (above footer) -->
  <div id="carousel-strip-wrapper" style="display:none;">
    <style>
      .carousel-strip { overflow: hidden; background: #0f172a; padding: 0; position: relative; }
      .carousel-strip::before,
      .carousel-strip::after {
        content: ''; position: absolute; top: 0; bottom: 0; width: 80px; z-index: 2; pointer-events: none;
      }
      .carousel-strip::before { left: 0; background: linear-gradient(to right, #0f172a, transparent); }
      .carousel-strip::after  { right: 0; background: linear-gradient(to left,  #0f172a, transparent); }

      .carousel-track { display: flex; width: max-content; animation: carouselScroll 30s linear infinite; }
      .carousel-track:hover { animation-play-state: paused; }
      @keyframes carouselScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

      .carousel-slide { flex-shrink: 0; width: 320px; height: 200px; margin: 0 10px; border-radius: 12px; overflow: hidden; position: relative; cursor: pointer; }
      .carousel-slide img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
      .carousel-slide:hover img { transform: scale(1.05); }
      .carousel-slide-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 60%); display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; }
      .carousel-slide-title { color: #fff; font-weight: 700; font-size: 0.95rem; line-height: 1.3; font-family: 'Outfit', sans-serif; }
      .carousel-slide-sub   { color: rgba(255,255,255,0.75); font-size: 0.78rem; margin-top: 3px; }

      .carousel-strip-heading { text-align: center; padding: 28px 20px 16px; background: #0f172a; }
      .carousel-strip-heading h3 { color: #fff; font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 800; margin: 0; }
      .carousel-strip-heading p  { color: rgba(255,255,255,0.55); font-size: 0.85rem; margin: 6px 0 0; }
    </style>

    <div class="carousel-strip-heading">
      <h3>Featured Research &amp; Highlights</h3>
      <p>Explore published work and milestones from our journals</p>
    </div>
    <div class="carousel-strip" style="padding: 12px 0 24px;">
      <div class="carousel-track" id="carousel-track"></div>
    </div>
  </div>

  <script>
  <%
    const API_BASE = process.env.SCRIPTHIVE_API_URL || 'http://localhost:3001';
    const slides = typeof carouselSlides !== 'undefined' ? carouselSlides : [];
  %>
  (function() {
    const slides = <%- JSON.stringify(slides) %>;
    const API    = '<%= API_BASE %>';
    if (!slides || slides.length === 0) return;
    const wrapper = document.getElementById('carousel-strip-wrapper');
    const track   = document.getElementById('carousel-track');
    if (!wrapper || !track) return;
    wrapper.style.display = 'block';

    const all = slides.concat(slides);
    all.forEach(function(s) {
      const div = document.createElement('div');
      div.className = 'carousel-slide';
      if (s.linkUrl) { div.style.cursor = 'pointer'; div.onclick = function(){ window.open(s.linkUrl, '_blank'); }; }
      const imgSrc = (API + '/' + s.imageUrl).replace(/([^:]\/)\/+/g,'$1');
      div.innerHTML = '<img src="' + imgSrc + '" alt="' + (s.title||'') + '" loading="lazy">' +
        '<div class="carousel-slide-overlay">' +
        (s.title    ? '<div class="carousel-slide-title">' + s.title + '</div>' : '') +
        (s.subtitle ? '<div class="carousel-slide-sub">'   + s.subtitle + '</div>' : '') +
        '</div>';
      track.appendChild(div);
    });

    const speed = Math.max(15, slides.length * 5);
    track.style.animationDuration = speed + 's';
  })();
  </script>

