<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ScriptHive Publication | International Research Journals Publisher</title>
  <meta name="description"
    content="ScriptHive Publication offers peer-reviewed international journals across multiple disciplines. Submit your research paper and get published with ISSN-supported journals.">
  <meta name="keywords"
    content="research journal, peer reviewed, open access, ISSN, submit paper, Publication , academic publishing">
  <meta property="og:title" content="ScriptHive Publication">
  <meta property="og:description"
    content="Advancing Knowledge Through Quality Research — Peer-reviewed, ISSN-supported journals.">
  <meta property="og:type" content="website">
  <link rel="icon" href="/images/only Logo.png" type="image/png">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- HEADER -->
  <header id="main-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/images/only Logo.png" alt="ScriptHive Logo">
        <div class="logo-text">
          <span>ScriptHive</span>
          <small>Publication </small>
        </div>
      </a>
      <nav class="main-nav" id="main-nav">
        <a href="/">Home</a>
        <a href="/about">About Us</a>
        <div class="nav-dropdown">
          <a href="/journals">Journals</a>
          <div class="dropdown-menu">
            <% (locals.activeJournals || []).forEach(function(j) { %>
              <a href="/<%= j.abbr %>"><%= j.abbr %> <span><%= j.shortDesc %></span></a>
            <% }); %>
          </div>
        </div>
        <a href="/services">Services</a>
        <a href="/subscription">Subscription</a>
        <a href="/contact">Contact</a>
      </nav>
      <% var _adminBase = process.env.ADMIN_PANEL_URL || 'https://admin.scripthive.org'; %>
      <a href="<%= _adminBase %>/author/login" target="_blank" class="btn btn-sm" style="margin-left:8px;border:1.5px solid #2563eb;color:#2563eb;background:#fff;border-radius:8px;padding:8px 16px;font-weight:600;font-size:0.85rem;text-decoration:none;white-space:nowrap;">Author Portal</a>
      <a href="/submit" class="btn btn-primary btn-sm nav-cta" style="margin-left:8px;">Submit Paper</a>
      <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

