        <i class="fa-solid fa-eye mv-icon"></i>
        <h3>Our Vision</h3>
        <p>To become a premier international publication house bridging knowledge creation and global academic
          discourse.</p>
        <ul class="mv-list">
          <li><i class="fa-solid fa-check-circle"></i> Expand journal portfolio</li>
          <li><i class="fa-solid fa-check-circle"></i> Build international collaborations</li>
          <li><i class="fa-solid fa-check-circle"></i> Strengthen indexing visibility</li>
          <li><i class="fa-solid fa-check-circle"></i> Become a trusted academic brand</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WHY PUBLISH -->
  <section class="why-publish">
    <div class="why-container">
      <h2 class="section-title gs-reveal-up">Why Researchers Choose ScriptHive</h2>
      <p class="section-subtitle gs-reveal-up" style="margin: 0 auto;">Built for researchers who value quality, speed,
        transparency, and global visibility.</p>

      <div class="why-grid">
        <div class="why-card gs-reveal-up">
          <i class="fa-solid fa-gauge-high why-icon"></i>
          <h4>Fast Review Process</h4>
          <p>Initial review within 7–15 working days with streamlined editorial workflows.</p>
        </div>
        <div class="why-card gs-reveal-up" style="transition-delay: 0.1s;">
          <i class="fa-solid fa-barcode why-icon"></i>
          <h4>ISSN-Supported Journals</h4>
          <p>All journals carry valid ISSN registration for publishing credibility and indexing support.</p>
        </div>
        <div class="why-card gs-reveal-up" style="transition-delay: 0.2s;">
          <i class="fa-solid fa-earth-europe why-icon"></i>
          <h4>Global Visibility</h4>
          <p>Open-access publishing ensures worldwide accessibility and citation potential.</p>
        </div>
        <div class="why-card gs-reveal-up" style="transition-delay: 0.3s;">
          <i class="fa-solid fa-scale-balanced why-icon"></i>
          <h4>Ethical Publishing</h4>
