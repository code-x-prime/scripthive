<%- include('../partials/header') %>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
  :root {
    --primary: #2563eb;
    --primary-dark: #1e40af;
    --navy: #0f172a;
    --gold: #fbbf24;
    --bg-light: #f8fafc;
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-border: rgba(255, 255, 255, 0.5);
    --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
  }
  body {
    background-color: var(--bg-light);
    font-family: "Inter", sans-serif;
    overflow-x: hidden;
  }
  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 20px;
    text-align: center;
  }
  .contact-hero {
    background: var(--navy);
    color: white;
    padding: 150px 20px 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-mesh {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    background:
      radial-gradient(
        circle at 20% 50%,
        rgba(37, 99, 235, 0.2) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(251, 191, 36, 0.15) 0%,
        transparent 50%
      );
    animation: pulseMesh 10s infinite alternate;
  }
  @keyframes pulseMesh {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.1);
      opacity: 1;
    }
  }
  .hero-content {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 50px;
    align-items: center;
  }
  .breadcrumb {
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 20px;
  }
  .breadcrumb a {
    color: #cbd5e1;
    text-decoration: none;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.9rem;
    margin-bottom: 20px;
    backdrop-filter: blur(10px);
  }
  .contact-hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    background: linear-gradient(to right, #fff, #cbd5e1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .contact-hero p {
    font-size: 1.2rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }
  .hero-stat-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 12px 20px;
    border-radius: 12px;
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .stat-icon {
    color: var(--gold);
    font-size: 1.2rem;
  }
  .stat-text {
    font-size: 0.85rem;
    color: #cbd5e1;
    font-weight: 600;
    text-transform: uppercase;
  }
  .hero-visual {
    position: relative;
    height: 400px;
  }
  .floating-bubble {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 20px;
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .fb-1 {
    top: 40px;
    right: 20px;
    animation: floatCard 6s infinite alternate ease-in-out;
  }
  .fb-2 {
    bottom: 60px;
    left: 0;
    background: linear-gradient(
      135deg,
      rgba(37, 99, 235, 0.2),
      rgba(30, 64, 175, 0.4)
    );
    animation: floatCard 5s infinite alternate-reverse ease-in-out;
  }
  .fb-3 {
    top: 200px;
    right: -20px;
    border-color: var(--gold);
    animation: floatCard 7s infinite alternate ease-in-out;
  }
  .fb-icon {
    background: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--primary);
  }
  @keyframes floatCard {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-20px);
    }
  }
  .contact-split {
    padding: 100px 20px;
    max-width: 1200px;
    margin: -50px auto 0;
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
  }
  .info-grid {
    display: grid;
    gap: 20px;
  }
  .info-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    padding: 25px;
    border-radius: 20px;
    box-shadow: var(--glass-shadow);
    transition: 0.3s;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    position: relative;
    overflow: hidden;
  }
  .info-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
    border-color: rgba(37, 99, 235, 0.3);
  }
  .info-icon {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .info-card.whatsapp .info-icon {
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
  }
  .info-content h4 {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 5px;
    font-weight: 600;
  }
  .info-content p {
    font-size: 1.1rem;
    color: var(--text-dark);
    font-weight: 700;
    margin: 0;
  }
  .info-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25d366;
    color: white;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    margin-top: 10px;
    transition: 0.3s;
    position: relative;
    z-index: 2;
  }
  .whatsapp-btn:hover {
    background: #1ebd57;
    transform: translateY(-2px);
    color: white;
  }
  .form-card {
    background: white;
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
    border: 1px solid var(--glass-border);
  }
  .form-card h3 {
    font-size: 2rem;
    color: var(--text-dark);
    margin-bottom: 30px;
    font-weight: 800;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .form-group {
    position: relative;
    margin-bottom: 25px;
  }
  .form-group.full {
    grid-column: 1/-1;
  }
  .form-control {
    width: 100%;
    padding: 15px 20px;
    background: var(--bg-light);
    border: 2px solid transparent;
    border-radius: 12px;
    font-size: 1rem;
    color: var(--text-dark);
    transition: 0.3s;
    outline: none;
    font-family: inherit;
  }
  .form-control:focus {
    border-color: var(--primary);
    background: white;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
  }
  .form-label {
    position: absolute;
    left: 20px;
    top: 15px;
    color: var(--text-muted);
    pointer-events: none;
    transition: 0.3s;
    font-size: 1rem;
  }
  .form-control:focus ~ .form-label,
  .form-control:not(:placeholder-shown) ~ .form-label {
    top: -10px;
    left: 10px;
    font-size: 0.8rem;
    background: white;
    padding: 0 5px;
    color: var(--primary);
    font-weight: 600;
    border-radius: 4px;
  }
  select.form-control {
    appearance: none;
    cursor: pointer;
  }
  .select-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }
  textarea.form-control {
    resize: vertical;
    min-height: 120px;
  }
  .file-drop {
    border: 2px dashed #cbd5e1;
    border-radius: 12px;
    padding: 30px;
    text-align: center;
    transition: 0.3s;
    cursor: pointer;
    background: var(--bg-light);
    position: relative;
    overflow: hidden;
  }
  .file-drop:hover {
    border-color: var(--primary);
  }
  .file-drop input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .file-drop-icon {
    font-size: 2rem;
    color: var(--primary);
    margin-bottom: 10px;
  }
  .submit-btn {
    background: linear-gradient(
      135deg,
      var(--primary) 0%,
      var(--primary-dark) 100%
    );
    color: white;
    border: none;
    width: 100%;
    padding: 18px;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
  }
  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3);
  }
  .support-topics {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .topic-card {
    background: white;
    border-radius: 16px;
    padding: 25px;
    display: flex;
    align-items: center;
    gap: 15px;
    border: 1px solid var(--glass-border);
    transition: 0.3s;
  }
  .topic-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
  }
  .topic-icon {
    font-size: 1.5rem;
    color: var(--primary);
    background: rgba(37, 99, 235, 0.1);
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }
  .topic-card h4 {
    font-size: 1rem;
    color: var(--text-dark);
    margin: 0;
    font-weight: 600;
  }
  .map-section {
    padding: 0;
    position: relative;
    height: 500px;
    background: #e2e8f0;
    overflow: hidden;
  }
  .map-overlay-card {
    position: absolute;
    top: 50%;
    left: 10%;
    transform: translateY(-50%);
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    padding: 30px;
    border-radius: 20px;
    box-shadow: var(--glass-shadow);
    border: 1px solid var(--glass-border);
    max-width: 350px;
    z-index: 2;
  }
  .map-overlay-card h3 {
    font-size: 1.5rem;
    color: var(--text-dark);
    margin-bottom: 15px;
    font-weight: 800;
  }
  .map-overlay-card p {
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .btn-direction {
    background: var(--text-dark);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: 0.3s;
  }
  .btn-direction:hover {
    background: black;
    color: white;
  }
  .quick-actions {
    padding: 100px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .qa-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .qa-card {
    background: var(--primary);
    color: white;
    padding: 30px;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;
    transition: 0.3s;
    display: block;
  }
  .qa-card.alt {
    background: white;
    color: var(--text-dark);
    border: 1px solid var(--glass-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  .qa-card:hover {
    transform: translateY(-10px);
  }
  .qa-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
    display: block;
  }
  .qa-card.alt .qa-icon {
    color: var(--primary);
  }
  .qa-card h4 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }
  .trust-section {
    padding: 80px 20px;
    background: white;
    text-align: center;
  }
  .trust-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    max-width: 1000px;
    margin: 40px auto 0;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--text-dark);
    background: var(--bg-light);
    padding: 15px 25px;
    border-radius: 12px;
    transition: 0.3s;
  }
  .trust-item i {
    color: #10b981;
    font-size: 1.2rem;
  }
  .final-cta {
    background: linear-gradient(135deg, var(--primary) 0%, #8b5cf6 100%);
    padding: 120px 20px;
    text-align: center;
    color: white;
  }
  .final-cta h2 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 20px;
  }
  .final-cta p {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-white {
    background: white;
    color: var(--primary);
    padding: 15px 35px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.3s;
    display: inline-block;
    margin: 0 10px 10px;
  }
  .btn-white:hover {
    transform: scale(1.05);
  }
  .btn-outline-white {
    border: 2px solid white;
    color: white;
    padding: 15px 35px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.3s;
    display: inline-block;
    margin: 0 10px 10px;
  }
  .btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    padding: 20px;
  }
  .modal-overlay.active {
    opacity: 1;
    pointer-events: all;
  }
  .premium-modal {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 24px;
    padding: 40px;
    width: 90%;
    max-width: 550px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: translateY(30px) scale(0.95);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-align: center;
    color: var(--text-dark);
    position: relative;
  }
  .modal-overlay.active .premium-modal {
    transform: translateY(0) scale(1);
  }
  .modal-glow {
    position: absolute;
    top: -50px;
    left: 50%;
    transform: translateX(-50%);
    width: 250px;
    height: 150px;
    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.2) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  .modal-glow.danger {
    background: radial-gradient(
      circle,
      rgba(239, 68, 68, 0.2) 0%,
      transparent 70%
    );
  }
  .modal-content {
    position: relative;
    z-index: 10;
  }
  .success-checkmark {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    background: rgba(16, 185, 129, 0.1);
    border: 2px solid #10b981;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: #10b981;
    animation: scaleInCheck 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes scaleInCheck {
    0% {
      transform: scale(0) rotate(-45deg);
      opacity: 0;
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }
  .error-cross {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    background: rgba(239, 68, 68, 0.1);
    border: 2px solid #ef4444;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: #ef4444;
    animation: shakeCross 0.5s ease-in-out;
  }
  @keyframes shakeCross {
    0%,
    100% {
      transform: translateX(0);
    }
    20%,
    60% {
      transform: translateX(-8px);
    }
    40%,
    80% {
      transform: translateX(8px);
    }
  }
  .modal-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .modal-message {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .submission-id-container {
    background: #f1f5f9;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
    font-family: monospace;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .loader-spinner {
    border: 4px solid rgba(37, 99, 235, 0.1);
    border-left-color: var(--primary);
    border-radius: 50%;
    width: 60px;
    height: 60px;
    margin: 0 auto 24px;
    animation: spinLoader 1s linear infinite;
  }
  @keyframes spinLoader {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  .progress-container {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    margin: 20px 0 10px;
    display: none;
  }
  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--gold));
    transition: width 0.3s ease;
  }
  .modal-btn-group {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .modal-btn {
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
  }
  .modal-btn.primary {
    background: linear-gradient(
      135deg,
      var(--primary) 0%,
      var(--primary-dark) 100%
    );
    color: white;
  }
  .modal-btn.primary:hover {
    transform: translateY(-2px);
  }
  .modal-btn.secondary {
    background: #e2e8f0;
    color: var(--text-dark);
  }
  .modal-btn.secondary:hover {
    background: #cbd5e1;
  }
  .modal-btn.danger {
    background: #ef4444;
    color: white;
  }
  @media (max-width: 900px) {
    .contact-split,
    .form-grid {
      grid-template-columns: 1fr;
    }
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-stats {
      justify-content: center;
    }
    .hero-visual {
      display: none;
    }
    .map-overlay-card {
      position: relative;
      top: 0;
      left: 0;
      transform: none;
      margin: 20px auto;
      max-width: 90%;
    }
    .contact-split {
      margin-top: 0;
      padding-top: 50px;
    }
    .premium-modal {
      padding: 24px 16px;
    }
    .contact-hero h1 {
      font-size: 2.2rem;
    }
  }
</style>

<section class="contact-hero">
  <div class="hero-mesh"></div>
  <div class="hero-content">
    <div class="hero-text gs-reveal">
      <div class="breadcrumb"><a href="/">Home</a> › Contact Us</div>
      <div class="hero-badge">
        <i class="fa-solid fa-headset"></i> Contact Us
      </div>
      <h1>Reach Out to Our Editorial Team</h1>
      <p>
        Contact ScriptHive Publication for manuscript submissions, publishing
        services, editorial collaborations, ISSN guidance, or general academic
        inquiries.
      </p>
