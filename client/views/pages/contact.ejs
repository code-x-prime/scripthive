<script>
  document.addEventListener("DOMContentLoaded", () => {
    gsap.registerPlugin(ScrollTrigger);
    gsap.utils
      .toArray(".gs-reveal")
      .forEach((el) =>
        gsap.from(el, {
          scrollTrigger: { trigger: el, start: "top 85%" },
          y: 50,
          opacity: 0,
          duration: 1,
          ease: "power3.out",
        }),
      );
    gsap.utils
      .toArray(".gs-reveal-up")
      .forEach((el) =>
        gsap.from(el, {
          scrollTrigger: { trigger: el, start: "top 85%" },
          y: 30,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
        }),
      );

    const fileInput = document.getElementById("attachment");
    const fileNameDisplay = document.getElementById("fileName");
    fileInput.addEventListener("change", function () {
      if (this.files && this.files[0]) {
        fileNameDisplay.style.display = "block";
        fileNameDisplay.innerHTML =
          '<i class="fa-solid fa-file-check"></i> Selected: ' +
          this.files[0].name;
      } else {
        fileNameDisplay.style.display = "none";
      }
    });

    const loadingOverlay = document.getElementById("loading-modal-overlay");
    const loadingTitle = document.getElementById("loading-title");
    const loadingMessage = document.getElementById("loading-message");
    const loadingProgressContainer = document.getElementById(
      "loading-progress-container",
    );
    const loadingProgressBar = document.getElementById("loading-progress-bar");
    const loadingPercentage = document.getElementById("loading-percentage");
    const successOverlay = document.getElementById("success-modal-overlay");
    const successQueryId = document.getElementById("success-query-id");
    const successSubject = document.getElementById("success-subject");
    const successName = document.getElementById("success-name");
    const errorOverlay = document.getElementById("error-modal-overlay");
    const errorModalMessage = document.getElementById("error-modal-message");

    function showError(msg) {
      errorModalMessage.innerText = msg;
      errorOverlay.classList.add("active");
    }
    document
      .getElementById("close-success-btn")
      .addEventListener("click", () =>
        successOverlay.classList.remove("active"),
      );
    document
      .getElementById("close-error-btn")
      .addEventListener("click", () => errorOverlay.classList.remove("active"));

    let currentQueryDetails = null;

    document
      .getElementById("contactForm")
      .addEventListener("submit", function (e) {
        e.preventDefault();
        if (!this.checkValidity()) {
          this.reportValidity();
          return;
        }
        const name = document.getElementById("name").value.trim();
        const email = document.getElementById("email").value.trim();
        const subject = document.getElementById("subject").value;
        const message = document.getElementById("message").value.trim();
        if (!name || !email || !subject || !message) {
          showError("Please fill out all required fields.");
          return;
        }

        loadingTitle.innerText = "Sending Message";
        loadingMessage.innerText = "Processing your inquiry...";
        loadingProgressContainer.style.display = "block";
        loadingProgressBar.style.width = "0%";
        loadingPercentage.innerText = "0%";
        loadingOverlay.classList.add("active");

        const formData = new FormData(this);
        const xhr = new XMLHttpRequest();
        xhr.open("POST", "/contact", true);
        xhr.upload.addEventListener("progress", function (e) {
          if (e.lengthComputable) {
            const p = Math.min(99, Math.round((e.loaded / e.total) * 100));
            loadingProgressBar.style.width = p + "%";
            loadingPercentage.innerText = p + "%";
            if (p >= 99) loadingTitle.innerText = "Finalizing";
          }
        });
        xhr.onload = function () {
          loadingOverlay.classList.remove("active");
          let resp = {};
          try {
            resp = JSON.parse(xhr.responseText);
          } catch (e) {
            resp = { status: "error", message: "Unexpected response." };
          }
          if (xhr.status === 200 && resp.status === "success") {
            currentQueryDetails = {
              query_id: resp.query_id,
              timestamp: resp.timestamp,
              name,
              email,
              subject,
              message,
            };
            successQueryId.innerText = resp.query_id;
            successSubject.innerText = subject;
            successName.innerText = name;
            successOverlay.classList.add("active");
            document.getElementById("contactForm").reset();
            fileNameDisplay.style.display = "none";
          } else {
            showError(
              resp.message || "Failed to send message. Please try again.",
            );
          }
        };
        xhr.onerror = function () {
          loadingOverlay.classList.remove("active");
          showError("A network error occurred.");
        };
        xhr.send(formData);
      });

    document
      .getElementById("download-receipt-btn")
      .addEventListener("click", function () {
        if (!currentQueryDetails) return;
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const { query_id, timestamp, name, email, subject, message } =
          currentQueryDetails;
        doc.setFillColor(15, 23, 42);
        doc.rect(0, 0, 210, 40, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("Helvetica", "bold");
        doc.setFontSize(22);
        doc.text("SCRIPTHIVE PUBLICATION", 20, 18);
        doc.setTextColor(251, 191, 36);
        doc.setFont("Helvetica", "normal");
        doc.setFontSize(10);
        doc.text("OFFICIAL QUERY RECEIPT", 20, 26);
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(8);
        doc.text("Date: " + timestamp, 150, 26);
        doc.setTextColor(15, 23, 42);
        doc.setFont("Helvetica", "bold");
        doc.setFontSize(14);
        doc.text("Query Metadata", 20, 55);
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(0.5);
        doc.line(20, 58, 190, 58);
        let y = 68;
        [
          ["Query ID", query_id],
          ["Name", name],
          ["Email", email],
          ["Subject", subject],
          ["Date", timestamp],
          ["Status", "Received"],
        ].forEach((row) => {
          doc.setFont("Helvetica", "bold");
          doc.setTextColor(100, 116, 139);
          doc.setFontSize(10);
          doc.text(row[0] + ":", 20, y);
          doc.setFont(
            row[0] === "Query ID" ? "Helvetica bold" : "Helvetica",
            "normal",
          );
          doc.setTextColor(15, 23, 42);
          const s = doc.splitTextToSize(row[1], 120);
          doc.text(s, 70, y);
          y += s.length * 5 + 3;
        });
        y += 10;
        doc.setFont("Helvetica", "bold");
        doc.setFontSize(12);
        doc.setTextColor(15, 23, 42);
        doc.text("Message Transcript", 20, y);
        y += 3;
        doc.line(20, y, 190, y);
        y += 8;
        doc.setFont("Helvetica", "normal");
        doc.setFontSize(10);
        doc.setTextColor(71, 85, 105);
        doc.text(doc.splitTextToSize(message, 170), 20, y);
        doc.setTextColor(15, 23, 42);
        doc.text("Sincerely,", 20, 250);
        doc.setFont("Helvetica", "bold");
        doc.text("Editorial Support Team", 20, 256);
        doc.setFont("Helvetica", "normal");
        doc.text("ScriptHive Publication", 20, 262);
        doc.setFontSize(9);
        doc.setTextColor(100, 116, 139);
        doc.text("www.scripthive.org | info@scripthive.org", 20, 268);
        doc.save("ScriptHive_Query_" + query_id + ".pdf");
      });
  });
</script>

