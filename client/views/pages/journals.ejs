        <div class="jl-actions">
          <a href="/SGJVSR" class="jl-btn jl-btn-primary">View Journal <i class="fa-solid fa-arrow-right"></i></a>
          <a href="/SGJVSR" class="jl-btn jl-btn-outline"><i class="fa-solid fa-bullseye"></i> Aim & Scope</a>
