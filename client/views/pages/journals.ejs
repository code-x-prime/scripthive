      </div>

      <div class="jl-card-right">
        <div class="jl-info-item"><i class="fa-solid fa-globe"></i> <div><span>Global Reach</span><span class="info-sub">International Readership</span></div></div>
        <div class="jl-info-item"><i class="fa-solid fa-user-secret" style="color:var(--brand-shield);"></i> <div><span>Double-Blind</span><span class="info-sub">Strict Peer Review</span></div></div>
        <div class="jl-info-item"><i class="fa-solid fa-bolt" style="color:var(--gold);"></i> <div><span>Fast Review</span><span class="info-sub">7-15 Working Days</span></div></div>
        <div class="jl-info-item"><i class="fa-solid fa-scale-balanced" style="color:#8b5cf6;"></i> <div><span>Ethical Publishing</span><span class="info-sub">COPE Guidelines</span></div></div>
      </div>
    </div>
    <% } %>

    <!-- Journal 2: SGMRJ -->
    <% if((locals.activeJournals||[]).some(function(j){return j.abbr==='SGMRJ';})) { %>
