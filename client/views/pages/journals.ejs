    <div class="jl-card gs-reveal-up">
      <div class="jl-card-left bg-grad-1">
        <div>
          <div class="jl-card-abbr">SGJVSR</div>
          <div class="jl-card-freq">Quarterly Journal</div>
        </div>
        <div>
          <div class="jl-card-issn-label">ISSN (Print & Online)</div>
          <div class="jl-card-issn">XXXX-XXXX (P)<br>XXXX-XXXX (O)</div>
        </div>
      </div>
      
      <div class="jl-card-center">
        <div class="jl-badge-group">
          <div class="jl-mini-badge"><i class="fa-solid fa-lock-open"></i> Open Access</div>
          <div class="jl-mini-badge"><i class="fa-solid fa-microscope" style="color:var(--brand-shield);"></i> Peer Reviewed</div>
        </div>
        <h2 class="jl-card-title">ScriptHive Global Journal of Vedic and Sanskrit Research</h2>
        <div class="jl-topics">
          <span class="jl-topic-tag">Vedic Studies</span>
          <span class="jl-topic-tag">Sanskrit Literature</span>
          <span class="jl-topic-tag">Indology</span>
          <span class="jl-topic-tag">Ancient Philosophy</span>
          <span class="jl-topic-tag">Classical Linguistics</span>
