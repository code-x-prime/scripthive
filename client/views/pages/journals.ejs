      <div class="jl-card-left bg-grad-2">
        <div>
          <div class="jl-card-abbr">SGMRJ</div>
          <div class="jl-card-freq">Quarterly Journal</div>
        </div>
        <div>
          <div class="jl-card-issn-label">ISSN (Print & Online)</div>
          <div class="jl-card-issn">XXXX-XXXX (P)<br>XXXX-XXXX (O)</div>
        </div>
      </div>
      
      <div class="jl-card-center">
        <div class="jl-badge-group">
          <div class="jl-mini-badge"><i class="fa-solid fa-lock-open"></i> Open Access</div>
          <div class="jl-mini-badge"><i class="fa-solid fa-microscope" style="color:var(--brand-shield);"></i> Peer Reviewed</div>
        </div>
