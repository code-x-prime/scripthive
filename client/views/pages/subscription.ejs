    <script>
        // GSAP Animations
        document.addEventListener("DOMContentLoaded", (event) => {
            gsap.registerPlugin(ScrollTrigger);

            // Reveal animations
            gsap.utils.toArray('.gs-reveal').forEach(function (elem) {
                gsap.from(elem, {
                    scrollTrigger: { trigger: elem, start: "top 85%" },
                    y: 50, opacity: 0, duration: 1, ease: "power3.out"
                });
            });

            gsap.utils.toArray('.gs-reveal-up').forEach(function (elem) {
                gsap.from(elem, {
                    scrollTrigger: { trigger: elem, start: "top 85%" },
                    y: 30, opacity: 0, duration: 0.8, ease: "power2.out"
                });
            });

            // Counters animation
            const counters = document.querySelectorAll('.counter-val');
            counters.forEach(counter => {
                gsap.to(counter, {
                    scrollTrigger: { trigger: counter, start: "top 90%" },
                    innerHTML: counter.getAttribute('data-target'),
                    duration: 2,
                    snap: { innerHTML: 1 },
                    onUpdate: function () {
                        let val = Math.round(this.targets()[0].innerHTML);
                        if (counter.getAttribute('data-target') == 10000) {
                            counter.innerHTML = val.toLocaleString('en-IN') + "+";
                        } else if (counter.getAttribute('data-target') == 99) {
                            counter.innerHTML = val + "%";
                        } else if (counter.getAttribute('data-target') == 24) {
                            counter.innerHTML = val + "/7";
                        } else {
                            counter.innerHTML = val + "+";
                        }
                    }
                });
            });

            // Toggle logic
            const toggle = document.getElementById('pricingToggle');
            const prices = document.querySelectorAll('.price-val');
            const lblMonthly = document.getElementById('label-yearly');
            const lblYearly = document.getElementById('label-monthly');

            toggle.addEventListener('change', (e) => {
                const isMonthly = e.target.checked;

                if (isMonthly) {
                    lblMonthly.classList.add('active');
                    lblYearly.classList.remove('active');
                } else {
                    lblYearly.classList.add('active');
                    lblMonthly.classList.remove('active');
                }

                prices.forEach(price => {
                    gsap.to(price, {
                        opacity: 0,
                        y: -10,
                        duration: 0.2,
                        onComplete: () => {
                            price.innerText = isMonthly ? price.getAttribute('data-monthly') : price.getAttribute('data-yearly');
                            let val = parseInt(price.innerText.replace(/,/g, ''));
                            if (val > 0) price.innerText = val.toLocaleString('en-IN');
                            gsap.to(price, { opacity: 1, y: 0, duration: 0.2 });
                        }
                    });
                });
            });
        });
    </script>

