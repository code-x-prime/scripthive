              ISO</div>
            <div class="stat-label">Certified</div>
          </div>
          <div class="hero-stat-card">
            <div class="stat-val counter" data-target="10000">0</div>
            <div class="stat-label">Researchers</div>
          </div>
          <div class="hero-stat-card">
            <div class="stat-val counter" data-target="100">0</div>
            <div class="stat-label">% Peer Reviewed</div>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="floating-card fc-1">
          <i class="fa-solid fa-book-open" style="font-size:2rem;color:var(--primary);margin-bottom:10px;"></i>
          <h4 style="color:white;margin-bottom:5px;">Journal Publishing</h4>
          <div style="height:4px;background:#3b82f6;width:50%;border-radius:2px;margin-bottom:5px;"></div>
          <div style="height:4px;background:rgba(255,255,255,0.2);width:80%;border-radius:2px;"></div>
        </div>
        <div class="floating-card fc-2">
          <i class="fa-solid fa-chart-pie" style="font-size:2rem;color:white;margin-bottom:10px;"></i>
          <h4 style="color:white;margin-bottom:5px;">Research Analytics</h4>
          <p style="color:#cbd5e1;font-size:0.8rem;">Global reach & citations</p>
        </div>
        <div class="floating-card fc-3">
          <i class="fa-solid fa-fingerprint" style="font-size:2rem;color:var(--gold);margin-bottom:10px;"></i>
          <h4 style="color:white;margin-bottom:5px;">DOI & ISSN</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE OFFER GRID -->
  <section class="offer-section">
    <h2 class="section-title gs-reveal-up">What We Offer</h2>
    <p class="section-subtitle gs-reveal-up">From journal publishing to editing and ISSN guidance — ScriptHive supports
      your complete academic publishing journey.</p>

    <div class="offer-grid">
