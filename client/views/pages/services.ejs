<%- include('../partials/header') %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1e40af;
      --navy: #0f172a;
      --gold: #fbbf24;
      --gold-light: #fef08a;
      --bg-light: #f8fafc;
      --text-dark: #1e293b;
      --text-muted: #64748b;
      --glass-bg: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(255, 255, 255, 0.5);
      --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }

    body {
      background-color: var(--bg-light);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Common */
    .section-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-dark);
      margin-bottom: 20px;
      text-align: center;
    }

    .section-subtitle {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 700px;
      margin: 0 auto 50px;
      text-align: center;
    }

    .btn-primary-custom {
      background: var(--primary);
      color: white;
      padding: 12px 28px;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.3s;
      display: inline-block;
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }

    .btn-primary-custom:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      color: white;
    }

    .btn-outline-custom {
      background: transparent;
      color: var(--primary);
      border: 2px solid var(--primary);
      padding: 10px 28px;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.3s;
      display: inline-block;
      margin-left: 10px;
    }

    .btn-outline-custom:hover {
      background: rgba(37, 99, 235, 0.05);
    }

    /* Hero Section */
    .services-hero {
      background: var(--navy);
      color: white;
      padding: 150px 20px 100px;
      position: relative;
      overflow: hidden;
    }

    .hero-mesh {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 0;
      background: radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.2) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(251, 191, 36, 0.15) 0%, transparent 50%);
      animation: pulseMesh 10s infinite alternate;
    }

    @keyframes pulseMesh {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }

      100% {
        transform: scale(1.1);
        opacity: 1;
      }
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .breadcrumb {
      font-size: 0.9rem;
      color: #94a3b8;
      margin-bottom: 20px;
    }

    .breadcrumb a {
      color: #cbd5e1;
      text-decoration: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 0.9rem;
      margin-bottom: 20px;
      backdrop-filter: blur(10px);
    }

    .services-hero h1 {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 20px;
      background: linear-gradient(to right, #fff, #cbd5e1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .services-hero p {
      font-size: 1.2rem;
      color: #94a3b8;
      line-height: 1.6;
      margin-bottom: 40px;
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .hero-stat-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 15px 20px;
      border-radius: 12px;
      backdrop-filter: blur(5px);
      flex: 1;
      min-width: 140px;
    }

    .stat-val {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--gold);
      margin-bottom: 5px;
    }

    .stat-label {
      font-size: 0.75rem;
      color: #cbd5e1;
      text-transform: uppercase;
    }

    .hero-visual {
      position: relative;
      height: 400px;
      perspective: 1000px;
    }

    .floating-card {
      position: absolute;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 20px;
      border-radius: 16px;
      backdrop-filter: blur(10px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .fc-1 {
      top: 30px;
      right: 20px;
      width: 260px;
      transform: rotateY(-10deg) rotateX(10deg);
      animation: floatCard 6s infinite alternate ease-in-out;
    }

    .fc-2 {
      bottom: 20px;
      left: 0;
      width: 230px;
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.2), rgba(30, 64, 175, 0.4));
      transform: rotateY(15deg) rotateX(-5deg);
      animation: floatCard 5s infinite alternate-reverse ease-in-out;
    }

    .fc-3 {
      top: -20px;
      left: 40px;
      width: 190px;
      border-color: var(--gold);
      animation: floatCard 7s infinite alternate ease-in-out;
    }

    @keyframes floatCard {
      0% {
        transform: translateY(0) rotateY(0) rotateX(0);
      }

      100% {
        transform: translateY(-20px) rotateY(-5deg) rotateX(5deg);
      }
    }

    /* What We Offer Grid */
    .offer-section {
      padding: 100px 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
    }

    .service-mini-card {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 30px 20px;
      text-align: center;
      box-shadow: var(--glass-shadow);
      transition: 0.4s;
      position: relative;
      overflow: hidden;
    }

    .service-mini-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, transparent, var(--primary), transparent);
      opacity: 0;
      transition: 0.3s;
    }

    .service-mini-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    }

    .service-mini-card:hover::before {
      opacity: 1;
    }

    .service-mini-card:hover .mini-icon {
      transform: scale(1.1);
      background: rgba(37, 99, 235, 0.1);
    }

    .mini-icon {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 70px;
      height: 70px;
      background: rgba(37, 99, 235, 0.05);
      border-radius: 16px;
      transition: 0.3s;
    }

    .service-mini-card h3 {
      font-size: 1.2rem;
      color: var(--text-dark);
      margin-bottom: 10px;
    }

    .service-mini-card p {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
    }

    /* Detailed Services Split Layout */
    .detail-section {
      padding: 100px 20px;
    }

    .detail-section.alt {
      background: var(--bg-light);
    }

    .detail-section.white {
      background: white;
    }

    .detail-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .detail-container.reverse {
      direction: rtl;
    }

    .detail-container.reverse>* {
      direction: ltr;
    }

    .detail-text h2 {
      font-size: 2.5rem;
      color: var(--text-dark);
      margin-bottom: 20px;
      font-weight: 800;
    }

    .detail-text p {
      color: var(--text-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .detail-list {
      list-style: none;
      padding: 0;
      margin-bottom: 30px;
    }

    .detail-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 15px;
      color: var(--text-dark);
      font-weight: 500;
      font-size: 1.05rem;
    }

    .detail-list li i {
      color: var(--primary);
      background: rgba(37, 99, 235, 0.1);
      padding: 5px;
      border-radius: 50%;
      font-size: 0.8rem;
    }

    .detail-visual {
      position: relative;
      height: 450px;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
    }

    /* Specific Visual Gradients */
    .v-journal {
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(37, 99, 235, 0.15));
    }

    .v-book {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.05), rgba(251, 191, 36, 0.15));
    }

    .v-sub {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(16, 185, 129, 0.15));
    }

    .v-issn {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(139, 92, 246, 0.15));
    }

    .v-edit {
      background: linear-gradient(135deg, rgba(236, 72, 153, 0.05), rgba(236, 72, 153, 0.15));
    }

    .visual-center-icon {
      font-size: 5rem;
      color: rgba(0, 0, 0, 0.1);
      position: absolute;
    }

    .detail-badge {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      background: white;
      padding: 12px 24px;
      border-radius: 30px;
      font-weight: 700;
      color: var(--text-dark);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 2;
    }

    .floating-element {
      position: absolute;
      background: white;
      padding: 15px;
      border-radius: 16px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-dark);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .fe-1 {
      top: 40px;
      right: -20px;
      animation: floatCard 4s infinite alternate ease-in-out;
    }

    .fe-2 {
      bottom: 80px;
      left: -20px;
      animation: floatCard 5s infinite alternate-reverse ease-in-out;
    }

    /* Process Timeline */
    .process-section {
      padding: 100px 20px;
      background: var(--bg-light);
      border-top: 1px solid rgba(0, 0, 0, 0.05);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .process-container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
    }

    .timeline {
      display: flex;
      justify-content: space-between;
      position: relative;
      margin-top: 60px;
      flex-wrap: wrap;
      gap: 30px;
    }

    .timeline::before {
      content: '';
      position: absolute;
      top: 40px;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, rgba(37, 99, 235, 0.1), rgba(37, 99, 235, 0.5), rgba(37, 99, 235, 0.1));
      z-index: 0;
    }

    .process-step {
      position: relative;
      z-index: 1;
      text-align: center;
      flex: 1;
      min-width: 150px;
    }

    .step-icon {
      width: 80px;
      height: 80px;
      background: white;
      border: 4px solid var(--bg-light);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: var(--primary);
      margin: 0 auto 20px;
      transition: 0.3s;
      position: relative;
    }

    .process-step:hover .step-icon {
      transform: scale(1.1);
      border-color: var(--primary);
      box-shadow: 0 15px 30px rgba(37, 99, 235, 0.2);
    }

    .step-number {
      position: absolute;
      top: -5px;
      right: -5px;
      background: var(--gold);
      color: #78350f;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      font-size: 0.8rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .process-step h4 {
      font-size: 1.1rem;
      color: var(--text-dark);
      margin-bottom: 10px;
    }

    /* Trust Cards */
    .trust-section {
      padding: 100px 20px;
      background: white;
    }

    .trust-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .trust-card {
      background: white;
      border-radius: 20px;
      padding: 30px;
      display: flex;
      align-items: center;
      gap: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
      transition: 0.3s;
      border: 1px solid var(--glass-border);
    }

    .trust-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
      border-color: rgba(37, 99, 235, 0.3);
    }

    .trust-card i {
      font-size: 2rem;
      color: var(--gold);
      background: rgba(251, 191, 36, 0.1);
      padding: 15px;
      border-radius: 12px;
    }

    .trust-card h4 {
      font-size: 1.1rem;
      color: var(--text-dark);
      margin: 0;
    }

    /* CTA */
    .final-cta {
      background: linear-gradient(135deg, var(--primary) 0%, #8b5cf6 100%);
      padding: 120px 20px;
      text-align: center;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .final-cta h2 {
      font-size: 3.5rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .final-cta p {
      font-size: 1.25rem;
      opacity: 0.9;
      margin-bottom: 40px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .btn-white {
      background: white;
      color: var(--primary);
      padding: 15px 35px;
      border-radius: 12px;
      font-weight: 700;
      text-decoration: none;
      transition: 0.3s;
      display: inline-block;
      margin: 0 10px 10px;
    }

    .btn-white:hover {
      transform: scale(1.05);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .btn-outline-white {
      border: 2px solid white;
      color: white;
      padding: 15px 35px;
      border-radius: 12px;
      font-weight: 700;
      text-decoration: none;
      transition: 0.3s;
      display: inline-block;
      margin: 0 10px 10px;
    }

    .btn-outline-white:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    @media (max-width: 900px) {

      .hero-content,
      .detail-container {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-stats {
        justify-content: center;
      }

      .hero-visual {
        display: none;
      }

      .detail-list li {
        justify-content: center;
      }

      .detail-badge {
        position: relative;
        bottom: 0;
        left: 0;
        transform: none;
        display: inline-flex;
        margin-top: 20px;
      }

      .floating-element {
        display: none;
      }

      .timeline::before {
        display: none;
      }

      .process-step {
        margin-bottom: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
    }

    @media (max-width: 600px) {

      .services-hero h1,
      .detail-text h2 {
        font-size: 2.5rem;
      }

      .final-cta h2 {
        font-size: 2.2rem;
      }

      .btn-primary-custom,
      .btn-outline-custom,
      .btn-white,
      .btn-outline-white {
        display: block;
        width: 100%;
        max-width: 300px;
        margin: 10px auto;
      }
    }
  </style>

  <!-- HERO SECTION -->
  <section class="services-hero">
    <div class="hero-mesh"></div>
    <div class="hero-content">
      <div class="hero-text gs-reveal">
        <div class="breadcrumb"><a href="/">Home</a> › Services</div>
        <div class="hero-badge"><i class="fa-solid fa-screwdriver-wrench"></i> Our Services</div>
