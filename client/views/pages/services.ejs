            class="fa-solid fa-pen-nib"></i></div>
        <h3>Editing & Proofreading</h3>
        <p>Professional manuscript editing, proofreading, formatting, and plagiarism review.</p>
      </div>
    </div>
  </section>

  <!-- 1. JOURNAL PUBLISHING -->
  <section class="detail-section white">
    <div class="detail-container">
      <div class="detail-text gs-reveal">
        <h2>Journal Publishing</h2>
        <p>ScriptHive provides complete academic journal publishing services covering the full lifecycle of scholarly
          publication — from ISSN registration and editorial setup to peer review coordination and final publication.
        </p>
        <ul class="detail-list">
          <li><i class="fa-solid fa-check"></i> ISSN registration for Print & Online editions</li>
          <li><i class="fa-solid fa-check"></i> Editorial workflow management</li>
          <li><i class="fa-solid fa-check"></i> Double-blind peer review coordination</li>
          <li><i class="fa-solid fa-check"></i> Professional typesetting and layout</li>
          <li><i class="fa-solid fa-check"></i> PDF & HTML article preparation</li>
          <li><i class="fa-solid fa-check"></i> Online journal hosting and archiving</li>
        </ul>
        <a href="/contact" class="btn-primary-custom">Enquire Now →</a>
        <a href="/journals" class="btn-outline-custom">Explore Journals</a>
      </div>
