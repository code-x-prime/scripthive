<%- include('../partials/header') %>

<!-- jsPDF CDN for Premium Client-Side PDF Generation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    --primary: #2563eb;
    --primary-dark: #1e40af;
    --navy: #0f172a;
    --gold: #fbbf24;
    --gold-light: #fef08a;
    --bg-light: #f8fafc;
    --text-dark: #1e293b;
    --text-muted: #64748b;
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-border: rgba(255, 255, 255, 0.5);
    --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    --brand-shield: #10b981;
    --brand-danger: #ef4444;
  }

  .submit-page {
    background-color: var(--bg-light);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    color: var(--text-dark);
  }

  .submit-page h1, .submit-page h2, .submit-page h3, .submit-page h4, .submit-page h5 {
    font-family: 'Outfit', sans-serif;
  }

  .section-title { font-size: 2.5rem; font-weight: 800; color: var(--text-dark); margin-bottom: 20px; text-align: center; }
  .section-subtitle { font-size: 1.1rem; color: var(--text-muted); line-height: 1.6; max-width: 700px; margin: 0 auto 50px; text-align: center; }

  /* Hero Section matched to contact.ejs */
  .submit-hero {
    background: var(--navy);
    color: white;
    padding: 150px 20px 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-mesh {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0;
    background: radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.2) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(251, 191, 36, 0.15) 0%, transparent 50%);
    animation: pulseMesh 10s infinite alternate;
  }

  @keyframes pulseMesh {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.1); opacity: 1; }
  }

  .hero-content {
    max-width: 1200px; margin: 0 auto;
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 50px; align-items: center;
  }

  .breadcrumb { font-size: 0.9rem; color: #94a3b8; margin-bottom: 20px; }
  .breadcrumb a { color: #cbd5e1; text-decoration: none; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 16px; border-radius: 30px; font-size: 0.9rem; margin-bottom: 20px;
    backdrop-filter: blur(10px); color: var(--gold);
  }

  .submit-hero h1 { font-size: 3.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 20px; background: linear-gradient(to right, #fff, #cbd5e1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .submit-hero p { font-size: 1.2rem; color: #94a3b8; line-height: 1.6; margin-bottom: 40px; }

  .hero-visual { position: relative; height: 400px; perspective: 1000px; }
  .floating-bubble {
    position: absolute; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
    padding: 20px; border-radius: 16px; backdrop-filter: blur(10px); box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    display: flex; align-items: center; gap: 15px;
  }
  .fb-1 { top: 40px; right: 20px; animation: floatCard 6s infinite alternate ease-in-out; }
  .fb-2 { bottom: 60px; left: 0; background: linear-gradient(135deg, rgba(37,99,235,0.2), rgba(30,64,175,0.4)); animation: floatCard 5s infinite alternate-reverse ease-in-out; }
  .fb-3 { top: 200px; right: -20px; border-color: var(--gold); animation: floatCard 7s infinite alternate ease-in-out; }
  .fb-icon { background: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--primary); }

  @keyframes floatCard {
    0% { transform: translateY(0); }
    100% { transform: translateY(-20px); }
  }

  /* Grid 4 for Features */
  .features-section { padding: 80px 20px; background: var(--bg-light); max-width: 1200px; margin: 0 auto; position: relative; z-index: 10; margin-top: -50px; }
  .sub-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .sub-feature-card {
    background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border);
    border-radius: 20px; padding: 32px 24px; text-align: center;
    transition: 0.3s; position: relative; overflow: hidden; box-shadow: var(--glass-shadow);
  }
  .sub-feature-card:hover { transform: translateY(-5px); border-color: rgba(37,99,235,0.3); box-shadow: 0 15px 30px rgba(0,0,0,0.08); }
  .sub-feature-card i { font-size: 2.5rem; color: var(--primary); margin-bottom: 16px; }
  .sub-feature-card h4 { font-size: 1.3rem; color: var(--text-dark); margin-bottom: 8px; font-weight: 700; }
  .sub-feature-card p { color: var(--text-muted); font-size: 0.95rem; margin: 0; }

  /* Compliance Section */
  .compliance-section { padding: 40px 20px 80px; max-width: 1200px; margin: 0 auto; }
  .sub-compliance-box {
    background: white;
    border: 1px solid var(--glass-border); border-radius: 24px; padding: 48px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
  }
  .sub-compliance-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 24px; }
  .sub-compliance-header i { font-size: 2rem; color: var(--gold); }
  .sub-compliance-header h3 { font-size: 1.8rem; color: var(--text-dark); margin: 0; font-weight: 800; }

  .sub-check-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .sub-check-item {
    display: flex; align-items: flex-start; gap: 16px;
    background: var(--bg-light); border: 1px solid rgba(0,0,0,0.05);
    padding: 16px 20px; border-radius: 16px; transition: 0.3s;
  }
  .sub-check-item:hover { background: white; border-color: var(--primary); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .sub-check-item i { color: #10b981; font-size: 1.2rem; margin-top: 2px; }
  .sub-check-item p { margin: 0; color: var(--text-dark); font-size: 1rem; line-height: 1.5; font-weight: 500; }

  #addon-total { display: none !important; }

  /* Form Container */
  *, *::before, *::after { box-sizing: border-box; }
  .form-container-wrapper { padding: 40px 20px 80px; max-width: 1000px; margin: 0 auto; width: 100%; }
  .form-card {
    background: white; border-radius: 24px; padding: 48px 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    border: 1px solid var(--glass-border); position: relative; overflow: hidden; width: 100%;
  }
  @media (max-width: 900px) {
    .form-card { padding: 32px 24px; border-radius: 16px; }
    .form-container-wrapper { padding: 20px 16px 60px; }
  }
  @media (max-width: 600px) {
    .form-card { padding: 20px 14px; border-radius: 12px; }
    .form-container-wrapper { padding: 16px 10px 50px; }
    .sub-form-header h2 { font-size: 1.6rem; }
  }
  .form-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 6px;
    background: linear-gradient(90deg, var(--primary), var(--gold));
  }
  
  .sub-form-header { text-align: center; margin-bottom: 48px; }
  .sub-form-header h2 { font-size: 2.5rem; color: var(--text-dark); margin-bottom: 12px; font-weight: 800; }
  .sub-form-header p { color: var(--text-muted); font-size: 1.1rem; }

  .sub-form-section { margin-bottom: 40px; }
  .sub-form-section-title { font-size: 1.3rem; color: var(--primary); margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-weight: 700; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 12px; }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form-group { position: relative; margin-bottom: 25px; }
  .form-group.full { grid-column: 1 / -1; }

  .form-control {
    width: 100%; padding: 18px 20px 10px; background: #ffffff; border: 1.5px solid #cbd5e1;
    border-radius: 12px; font-size: 1rem; color: var(--text-dark); transition: border-color 0.2s, box-shadow 0.2s; outline: none;
    font-family: inherit;
  }
  .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
  .form-control:hover:not(:focus) { border-color: #94a3b8; }
  .form-label {
    position: absolute; left: 20px; top: 14px; color: var(--text-muted); pointer-events: none;
    transition: 0.2s; font-size: 0.95rem; font-weight: 500;
  }
  .form-control:focus ~ .form-label, .form-control:not(:placeholder-shown) ~ .form-label {
    top: 5px; font-size: 0.72rem; color: var(--primary); font-weight: 700; letter-spacing: 0.02em;
  }

  select.form-control { appearance: none; cursor: pointer; }
  .select-icon { position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  textarea.form-control { resize: vertical; min-height: 120px; }

  /* File Drop Zone */
  .file-drop {
    border: 2px dashed #cbd5e1; border-radius: 12px; padding: 40px 20px; text-align: center;
    transition: 0.3s; cursor: pointer; background: var(--bg-light); position: relative; overflow: hidden;
  }
  .file-drop:hover { border-color: var(--primary); background: rgba(37,99,235,0.02); }
  .file-drop input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .file-drop-icon { font-size: 3rem; color: var(--primary); margin-bottom: 16px; }
  .file-drop p { color: var(--text-dark); font-weight: 600; font-size: 1.1rem; margin-bottom: 8px; }
  .file-drop span { color: var(--text-muted); font-size: 0.9rem; }
  .sub-file-name { margin-top: 16px; font-weight: 700; color: #10b981; font-size: 1rem; }

  /* Checkbox */
  .sub-checkbox-group {
    display: flex; align-items: flex-start; gap: 16px;
    background: rgba(16,185,129,0.05); border: 1px solid rgba(16,185,129,0.2);
    padding: 24px; border-radius: 16px; margin-top: 20px;
  }
  .sub-checkbox {
    appearance: none; width: 24px; height: 24px; border: 2px solid #cbd5e1;
    border-radius: 6px; cursor: pointer; position: relative; flex-shrink: 0; margin-top: 2px;
    transition: 0.2s; background: white;
  }
  .sub-checkbox:checked { background: #10b981; border-color: #10b981; }
  .sub-checkbox:checked::after {
    content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    color: white; font-size: 0.8rem;
  }
  .sub-checkbox-label { color: var(--text-dark); font-size: 0.95rem; line-height: 1.6; cursor: pointer; font-weight: 500; }

  /* Submit Button */
  .submit-btn {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white; border: none; width: 100%; padding: 20px; border-radius: 16px;
    font-size: 1.2rem; font-weight: 800; cursor: pointer; transition: 0.3s;
    box-shadow: 0 10px 20px rgba(37,99,235,0.2); position: relative; overflow: hidden; margin-top: 30px;
  }
  .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(37,99,235,0.3); }
  .submit-btn::after {
    content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
    background: rgba(255,255,255,0.2); transform: rotate(45deg); transition: 0.5s; opacity: 0;
  }
  .submit-btn:hover::after { opacity: 1; left: 100%; }

  .sub-btn-outline {
    padding: 12px 24px; font-size: 0.95rem; background: var(--bg-light); border: 1px solid #cbd5e1; color: var(--text-dark); border-radius: 12px; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; font-weight: 600;
  }
  .sub-btn-outline:hover {
    border-color: var(--primary); color: var(--primary); background: white;
  }

  /* Note Section */
  .sub-note-section { margin-top: 60px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .sub-note-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow);
    padding: 32px; border-radius: 20px; backdrop-filter: blur(10px);
  }
  .sub-note-card h4 { font-size: 1.2rem; color: var(--text-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; font-weight: 800; }
  .sub-note-list { list-style: none; padding: 0; margin: 0; }
  .sub-note-list li { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 12px; line-height: 1.5; display: flex; gap: 10px; font-weight: 500; }
  .sub-note-list li i { color: var(--gold); margin-top: 4px; }

  .sub-contact-grid { display: flex; flex-direction: column; gap: 16px; }
  .sub-contact-item { display: flex; align-items: center; gap: 16px; background: white; padding: 16px; border-radius: 12px; border: 1px solid rgba(0,0,0,0.05); }
  .sub-contact-item i { font-size: 1.5rem; color: var(--primary); }
  .sub-contact-item div { color: var(--text-dark); font-weight: 700; font-size: 1rem; }
  .sub-contact-item span { display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 500; margin-bottom: 2px; }

  /* Status UI / Trust */
  .sub-trust-badges { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 60px; }
  .sub-trust-badge { display: flex; align-items: center; gap: 10px; color: var(--text-dark); font-size: 0.95rem; background: var(--bg-light); padding: 10px 20px; border-radius: 30px; border: 1px solid rgba(0,0,0,0.05); font-weight: 600; }
  .sub-trust-badge i { color: #10b981; }

  /* Responsive */
  @media (max-width: 992px) {
    .hero-content { grid-template-columns: 1fr; text-align: center; }
    .hero-visual { display: none; }
    .submit-hero h1 { font-size: 3rem; }
    .sub-subtitle { margin: 0 auto 40px; }
    .hero-stats { justify-content: center; }
    .sub-grid-4 { grid-template-columns: 1fr 1fr; }
    .sub-check-grid { grid-template-columns: 1fr; }
    .form-card { padding: 40px 24px; }
    .form-grid { grid-template-columns: 1fr; }
    .sub-note-section { grid-template-columns: 1fr; }
  }
  @media (max-width: 576px) {
    .sub-grid-4 { grid-template-columns: 1fr; }
  }

  /* Premium Modal styling */
  .modal-overlay {
    position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(12px);
    display: flex; align-items: center; justify-content: center; z-index: 9999;
    opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
  }
  .modal-overlay.active { opacity: 1; pointer-events: all; }

  .premium-modal {
    background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 24px;
    padding: 40px; width: 90%; max-width: 550px; max-height: 90vh; overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: translateY(30px) scale(0.95); transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-align: center; color: var(--text-dark); position: relative;
  }
  @media (max-width: 600px) {
    .premium-modal { padding: 24px 16px; border-radius: 16px; }
  }
  .modal-overlay.active .premium-modal { transform: translateY(0) scale(1); }

  .modal-glow {
    position: absolute; top: -50px; left: 50%; transform: translateX(-50%);
    width: 250px; height: 150px; background: radial-gradient(circle, rgba(37,99,235,0.2) 0%, transparent 70%);
    pointer-events: none; z-index: 0;
  }
  .modal-glow.danger {
    background: radial-gradient(circle, rgba(239,68,68,0.2) 0%, transparent 70%);
  }

  .modal-content { position: relative; z-index: 10; }

  /* Success Tick Animation */
  .success-checkmark {
    width: 80px; height: 80px; margin: 0 auto 24px;
    background: rgba(16, 185, 129, 0.1); border: 2px solid #10b981; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-size: 2.2rem; color: #10b981;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.2);
    animation: scaleInCheck 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes scaleInCheck {
    0% { transform: scale(0) rotate(-45deg); opacity: 0; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }

  /* Error Cross Animation */
  .error-cross {
    width: 80px; height: 80px; margin: 0 auto 24px;
    background: rgba(239, 68, 68, 0.1); border: 2px solid #ef4444; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-size: 2.2rem; color: #ef4444;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
    animation: shakeCross 0.5s ease-in-out;
  }
  @keyframes shakeCross {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-8px); }
    40%, 80% { transform: translateX(8px); }
  }

  .modal-title { font-size: 1.8rem; font-weight: 800; margin-bottom: 12px; font-family: 'Outfit', sans-serif; }
  .modal-message { color: var(--text-muted); font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px; }

  /* Submission ID styling */
  .submission-id-container {
    background: #f1f5f9; border: 1px dashed #cbd5e1; border-radius: 12px;
    padding: 16px; margin-bottom: 24px; font-family: monospace; font-size: 1.3rem;
    font-weight: 700; color: var(--primary); display: flex; align-items: center; justify-content: center; gap: 10px;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }

  /* Loader Spinner */
  .loader-spinner {
    border: 4px solid rgba(37, 99, 235, 0.1); border-left-color: var(--primary);
    border-radius: 50%; width: 60px; height: 60px; margin: 0 auto 24px;
    animation: spinLoader 1s linear infinite;
  }
  @keyframes spinLoader {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .progress-container {
    width: 100%; height: 8px; background: #e2e8f0; border-radius: 10px;
    overflow: hidden; margin: 20px 0 10px; display: none;
  }
  .progress-bar {
    width: 0%; height: 100%; background: linear-gradient(90deg, var(--primary), var(--gold));
    transition: width 0.3s ease;
  }

  .modal-btn-group { display: flex; gap: 16px; justify-content: center; }
  .modal-btn {
    padding: 14px 28px; border-radius: 12px; font-size: 1rem; font-weight: 700;
    cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 8px; border: none;
  }
  .modal-btn.primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white;
    box-shadow: 0 8px 16px rgba(37,99,235,0.2);
  }
  .modal-btn.primary:hover { transform: translateY(-2px); box-shadow: 0 12px 20px rgba(37,99,235,0.3); }
  .modal-btn.secondary {
    background: #e2e8f0; color: var(--text-dark);
  }
  .modal-btn.secondary:hover { background: #cbd5e1; transform: translateY(-2px); }
  .modal-btn.danger {
    background: var(--brand-danger); color: white;
  }
  .modal-btn.danger:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(239,68,68,0.2); }
</style>


<div class="submit-page">
  
  <!-- HERO SECTION -->
  <section class="submit-hero">
    <div class="hero-mesh"></div>
    <div class="hero-content">
      <div class="hero-text gs-reveal">
        <div class="breadcrumb"><a href="/">Home</a> › Submit Paper</div>
        <div class="hero-badge"><i class="fa-solid fa-file-arrow-up"></i> Submit Your Paper</div>
        <h1>Submit Your<br>Research Manuscript</h1>
        <p class="sub-subtitle">Fill out the submission form below to submit your manuscript for peer review and publication consideration. We respond within 7–15 working days.</p>
        
        <div class="hero-stats">
          <div class="hero-stat-card"><i class="fa-solid fa-bolt stat-icon"></i> <span class="stat-text" style="color:white;">7–15 Day Review</span></div>
          <div class="hero-stat-card"><i class="fa-solid fa-lock-open stat-icon"></i> <span class="stat-text" style="color:white;">Open Access</span></div>
          <div class="hero-stat-card"><i class="fa-solid fa-certificate stat-icon"></i> <span class="stat-text" style="color:white;">ISSN Registered</span></div>
        </div>
      </div>
      
      <div class="hero-visual gs-reveal">
        <div class="floating-bubble fb-1">
          <div class="fb-icon"><i class="fa-solid fa-file-signature"></i></div>
          <div>
            <div style="font-weight:700;color:white;">Submit Manuscript</div>
            <div style="font-size:0.8rem;color:#cbd5e1;">Word Format</div>
          </div>
        </div>
        <div class="floating-bubble fb-2">
          <div class="fb-icon" style="color:#10b981;"><i class="fa-solid fa-microscope"></i></div>
          <div>
            <div style="font-weight:700;color:white;">Peer Review</div>
            <div style="font-size:0.8rem;color:#cbd5e1;">Double-Blind</div>
          </div>
        </div>
        <div class="floating-bubble fb-3">
          <div class="fb-icon" style="color:var(--gold);"><i class="fa-solid fa-check-double"></i></div>
          <div>
            <div style="font-weight:700;color:white;">Publishing</div>
            <div style="font-size:0.8rem;color:#cbd5e1;">Global Visibility</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Highlights -->
  <section class="features-section gs-reveal-up">
    <div class="sub-grid-4">
      <div class="sub-feature-card">
        <i class="fa-solid fa-bolt"></i>
        <h4>7–15 Days</h4>
