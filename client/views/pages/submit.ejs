    <div class="sub-compliance-box">
      <div class="sub-compliance-header">
        <i class="fa-solid fa-clipboard-check"></i>
        <h3>Before You Submit — Please Note</h3>
      </div>
      <div class="sub-check-grid">
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>Manuscript must be original and not currently under review elsewhere.</p>
        </div>
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>Submit exclusively in MS Word format (.doc or .docx).</p>
        </div>
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>Include a structured Abstract (150–250 words) and 5–7 keywords.</p>
        </div>
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>Plagiarism must be strictly below 15% (checked before review).</p>
        </div>
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>Adhere to APA or Vancouver citation styles uniformly.</p>
        </div>
        <div class="sub-check-item">
          <i class="fa-solid fa-check"></i>
          <p>All submissions undergo rigorous double-blind peer review.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Form -->
  <section class="form-container-wrapper gs-reveal">
    <div class="form-card">
      <div class="sub-form-header">
        <h2>Submit Your Manuscript</h2>
        <p>Fill out all required fields marked with <span class="sub-req" style="color:var(--brand-danger);">*</span></p>
      </div>

      <form id="paper-submit-form" novalidate>

        <!-- Author Info -->
        <div class="sub-form-section">
          <div class="sub-form-section-title"><i class="fa-solid fa-user"></i> Author Information</div>
          <div class="form-grid">
            <div class="form-group">
              <input type="text" id="author-name" name="author_name" class="form-control" placeholder=" " required>
              <label for="author-name" class="form-label">Full Name *</label>
            </div>
            <div class="form-group">
              <input type="email" id="author-email" name="author_email" class="form-control" placeholder=" " required>
              <label for="author-email" class="form-label">Email Address *</label>
            </div>
            <div class="form-group">
              <input type="tel" id="author-phone" name="author_phone" class="form-control" placeholder=" ">
              <label for="author-phone" class="form-label">Phone Number</label>
            </div>
            <div class="form-group" style="position:relative;">
              <label style="position:absolute;top:-10px;left:10px;font-size:0.8rem;background:white;padding:0 5px;color:var(--primary);font-weight:600;z-index:2;">Country *</label>
              <input type="text" id="country-search" autocomplete="off" class="form-control" placeholder="Search country..." required
                style="cursor:pointer;" readonly onclick="this.removeAttribute('readonly');this.select();">
              <input type="hidden" id="author-country" name="country" required>
              <div id="country-dropdown" style="display:none;position:absolute;top:100%;left:0;right:0;background:white;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.1);z-index:100;max-height:220px;overflow-y:auto;">
                <div style="padding:8px 10px;border-bottom:1px solid #f1f5f9;position:sticky;top:0;background:white;">
                  <input type="text" id="country-filter" placeholder="Type to search..." autocomplete="off"
                    style="width:100%;border:1px solid #e2e8f0;border-radius:8px;padding:6px 10px;font-size:0.9rem;outline:none;">
                </div>
                <div id="country-list"></div>
              </div>
              <span id="country-currency-badge" style="display:none;position:absolute;right:12px;top:50%;transform:translateY(-50%);background:#eff6ff;color:#2563eb;font-size:0.75rem;font-weight:700;padding:3px 8px;border-radius:8px;"></span>
            </div>
          </div>
        </div>

        <!-- Journal Selection -->
        <div class="sub-form-section">
          <div class="sub-form-section-title"><i class="fa-solid fa-book-open"></i> Journal Selection</div>
          <div class="form-group full">
            <%
              const journals = [
                { id: 'SGJVSR', name: 'ScriptHive Global Journal of Vedic and Sanskrit Research (SGJVSR)' },
                { id: 'SGMRJ',  name: 'ScriptHive Global Multidisciplinary Research Journal (SGMRJ)' },
                { id: 'SGJPLS', name: 'ScriptHive Global Journal of Physical and Life Sciences (SGJPLS)' },
                { id: 'SGJETR', name: 'ScriptHive Global Journal of Engineering and Technology Research (SGJETR)' },
                { id: 'SGJSSH', name: 'ScriptHive Global Journal of Social Sciences and Humanities (SGJSSH)' },
                { id: 'SGJASH', name: 'ScriptHive Global Journal of Applied Science and Health (SGJASH)' }
              ];
              const preJ = typeof preselectedJournal !== 'undefined' ? preselectedJournal : '';
            %>
            <select id="journal-select" name="journal" class="form-control" required>
              <option value="" disabled <%= preJ ? '' : 'selected' %>></option>
              <% journals.forEach(function(j){ %>
                <option value="<%= j.id %>" <%= preJ === j.id ? 'selected' : '' %>><%= j.name %></option>
              <% }); %>
            </select>
            <label for="journal-select" class="form-label">Select Journal *</label>
            <i class="fa-solid fa-chevron-down select-icon"></i>
          </div>
        </div>

        <!-- Manuscript Details -->
        <div class="sub-form-section">
          <div class="sub-form-section-title"><i class="fa-solid fa-pen-nib"></i> Manuscript Details</div>
          <div class="form-grid">
            <div class="form-group full">
              <input type="text" id="paper-title" name="paper_title" class="form-control" placeholder=" " required>
              <label for="paper-title" class="form-label">Paper Title *</label>
            </div>
            <div class="form-group full" id="authors-container">
              <div style="font-weight: 600; color: var(--text-dark); margin-bottom: 10px; font-size: 0.95rem;">Author Names <span style="color:var(--brand-danger);">*</span></div>
              <div class="author-input-group" style="margin-bottom:16px; position:relative;">
                <input type="text" id="author_name_1" name="author_names[]" class="form-control" placeholder=" " required>
                <label for="author_name_1" class="form-label">Author Name 1 *</label>
              </div>
              <div class="author-input-group" style="margin-bottom:16px; position:relative;">
                <input type="text" id="author_name_2" name="author_names[]" class="form-control" placeholder=" ">
                <label for="author_name_2" class="form-label">Author Name 2</label>
              </div>
              
            </div>
            <div class="form-group full">
              <button type="button" id="add-author-btn" class="sub-btn-outline">
                <i class="fa-solid fa-plus"></i> Add More Author Names
              </button>
            </div>
            <div class="form-group full" style="margin-top: 15px;">
              <textarea id="abstract" name="abstract" class="form-control" placeholder=" " required></textarea>
              <label for="abstract" class="form-label">Abstract * (150–250 words)</label>
            </div>
            <div class="form-group full">
              <input type="text" id="keywords" name="keywords" class="form-control" placeholder=" " required>
              <label for="keywords" class="form-label">Keywords * (5–7 keywords, comma separated)</label>
            </div>
          </div>
        </div>

        <!-- File Upload -->
        <div class="sub-form-section">
          <div class="sub-form-section-title"><i class="fa-solid fa-cloud-arrow-up"></i> Upload Manuscript</div>
          <div class="form-group full">
            <div class="file-drop" id="manuscript-drop">
              <input type="file" name="manuscript" id="manuscript" accept=".pdf,.doc,.docx" required>
              <div class="file-drop-icon"><i class="fa-solid fa-file-arrow-up"></i></div>
              <p>Drag & drop your manuscript here or click to browse</p>
              <span>Supported: PDF, DOC, DOCX — Max 10 MB</span>
              <div class="sub-file-name" id="file-name-display" style="display:none;"></div>
            </div>
          </div>
        </div>

        <!-- Add-on Services (dynamic from backend) -->
        <div class="sub-form-section" id="addon-section" style="display:none;">
          <div class="sub-form-section-title"><i class="fa-solid fa-plus-circle"></i> Add-On Services <span style="font-size:0.75rem;font-weight:500;color:#64748b;">(Optional)</span></div>
          <p style="font-size:0.88rem;color:#64748b;margin-bottom:16px;">Select optional paid services for your submission.</p>
          <div id="addon-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;"></div>
          <div id="addon-total" style="display:none !important;margin-top:14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;justify-content:space-between;align-items:center;">
            <span style="font-size:0.9rem;font-weight:600;color:#166534;">Total add-ons</span>
            <span id="addon-total-amt" style="font-family:monospace;font-weight:800;color:#15803d;font-size:1rem;"></span>
          </div>
          <input type="hidden" name="addons" id="addons-input" value="">
        </div>

        <!-- Declaration -->
        <div class="form-group full">
          <div class="sub-checkbox-group">
            <input type="checkbox" id="declaration" name="declaration" class="sub-checkbox" required>
            <label for="declaration" class="sub-checkbox-label">
              I confirm that this manuscript is original, has not been previously published, and is not currently under review elsewhere. I agree to the publication ethics and author guidelines of ScriptHive Publication.
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="submit-btn">
          Submit Paper <i class="fa-solid fa-paper-plane" style="margin-left:8px;"></i>
        </button>

      </form>

      <!-- Trust Badges inside form container -->
      <div class="sub-trust-badges">
        <div class="sub-trust-badge"><i class="fa-solid fa-shield-halved"></i> Secure Submission</div>
        <div class="sub-trust-badge"><i class="fa-solid fa-lock"></i> Data Privacy Protected</div>
        <div class="sub-trust-badge"><i class="fa-solid fa-scale-balanced"></i> Ethical Publishing</div>
      </div>

    </div>

    <!-- Note Section -->
    <div class="sub-note-section gs-reveal-up">
      <div class="sub-note-card">
        <h4><i class="fa-solid fa-circle-info" style="color:var(--primary);"></i> Important Information</h4>
        <ul class="sub-note-list">
          <li><i class="fa-solid fa-angle-right"></i> All submissions undergo rigorous double-blind peer review.</li>
          <li><i class="fa-solid fa-angle-right"></i> Authors will be notified of the editorial decision within 7–15 working days.</li>
          <li><i class="fa-solid fa-angle-right"></i> Please ensure your manuscript follows the Author Guidelines before submission.</li>
        </ul>
      </div>
      <div class="sub-note-card">
        <h4><i class="fa-solid fa-headset" style="color:var(--gold);"></i> Need Assistance?</h4>
        <div class="sub-contact-grid">
          <div class="sub-contact-item">
            <i class="fa-solid fa-envelope"></i>
            <div>
              <span>Email Support</span>
              info@scripthive.org
            </div>
          </div>
          <div class="sub-contact-item">
            <i class="fa-solid fa-phone"></i>
            <div>
              <span>Phone / WhatsApp</span>
              +91 9899916683
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- Animation & Logic Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function () {

    // ── Searchable Country Dropdown ──────────────────────────────
    const COUNTRIES = [
      'Afghanistan','Albania','Algeria','Andorra','Angola','Antigua and Barbuda','Argentina','Armenia','Australia',
      'Austria','Azerbaijan','Bahamas','Bahrain','Bangladesh','Barbados','Belarus','Belgium','Belize','Benin',
      'Bhutan','Bolivia','Bosnia and Herzegovina','Botswana','Brazil','Brunei','Bulgaria','Burkina Faso','Burundi',
      'Cabo Verde','Cambodia','Cameroon','Canada','Central African Republic','Chad','Chile','China','Colombia',
      'Comoros','Congo','Costa Rica','Croatia','Cuba','Cyprus','Czech Republic','Denmark','Djibouti','Dominica',
      'Dominican Republic','Ecuador','Egypt','El Salvador','Equatorial Guinea','Eritrea','Estonia','Eswatini',
      'Ethiopia','Fiji','Finland','France','Gabon','Gambia','Georgia','Germany','Ghana','Greece','Grenada',
      'Guatemala','Guinea','Guinea-Bissau','Guyana','Haiti','Honduras','Hungary','Iceland','India','Indonesia',
      'Iran','Iraq','Ireland','Israel','Italy','Jamaica','Japan','Jordan','Kazakhstan','Kenya','Kiribati',
      'Kuwait','Kyrgyzstan','Laos','Latvia','Lebanon','Lesotho','Liberia','Libya','Liechtenstein','Lithuania',
      'Luxembourg','Madagascar','Malawi','Malaysia','Maldives','Mali','Malta','Marshall Islands','Mauritania',
      'Mauritius','Mexico','Micronesia','Moldova','Monaco','Mongolia','Montenegro','Morocco','Mozambique',
      'Myanmar','Namibia','Nauru','Nepal','Netherlands','New Zealand','Nicaragua','Niger','Nigeria',
      'North Korea','North Macedonia','Norway','Oman','Pakistan','Palau','Palestine','Panama','Papua New Guinea',
      'Paraguay','Peru','Philippines','Poland','Portugal','Qatar','Romania','Russia','Rwanda','Saint Kitts and Nevis',
      'Saint Lucia','Saint Vincent and the Grenadines','Samoa','San Marino','Sao Tome and Principe','Saudi Arabia',
      'Senegal','Serbia','Seychelles','Sierra Leone','Singapore','Slovakia','Slovenia','Solomon Islands','Somalia',
      'South Africa','South Korea','South Sudan','Spain','Sri Lanka','Sudan','Suriname','Sweden','Switzerland',
      'Syria','Taiwan','Tajikistan','Tanzania','Thailand','Timor-Leste','Togo','Tonga','Trinidad and Tobago',
      'Tunisia','Turkey','Turkmenistan','Tuvalu','Uganda','Ukraine','United Arab Emirates','United Kingdom',
      'United States','Uruguay','Uzbekistan','Vanuatu','Vatican City','Venezuela','Vietnam','Yemen','Zambia','Zimbabwe'
    ];

    const countrySearch = document.getElementById('country-search');
    const countryHidden = document.getElementById('author-country');
    const countryDropdown = document.getElementById('country-dropdown');
    const countryFilter = document.getElementById('country-filter');
    const countryList = document.getElementById('country-list');
    const currencyBadge = document.getElementById('country-currency-badge');

    function renderCountries(filter) {
      const f = (filter || '').toLowerCase();
      countryList.innerHTML = '';
      COUNTRIES.filter(function(c){ return !f || c.toLowerCase().includes(f); }).forEach(function(c) {
        const isIndia = c === 'India';
        const div = document.createElement('div');
        div.style.cssText = 'padding:10px 14px;cursor:pointer;font-size:0.9rem;display:flex;justify-content:space-between;align-items:center;';
        div.innerHTML = '<span>' + c + '</span><span style="font-size:0.72rem;font-weight:700;color:' + (isIndia ? '#2563eb' : '#10b981') + ';background:' + (isIndia ? '#eff6ff' : '#f0fdf4') + ';padding:2px 7px;border-radius:6px;">' + (isIndia ? 'INR' : 'USD') + '</span>';
        div.addEventListener('mouseover', function(){ this.style.background='#f8fafc'; });
        div.addEventListener('mouseout', function(){ this.style.background=''; });
        div.addEventListener('click', function() {
          countrySearch.value = c;
          countryHidden.value = c;
          countryDropdown.style.display = 'none';
          currencyBadge.textContent = isIndia ? '₹ INR' : '$ USD';
          currencyBadge.style.display = 'inline-block';
        });
        countryList.appendChild(div);
      });
    }

    renderCountries('');

    countrySearch.addEventListener('focus', function() {
      countryDropdown.style.display = 'block';
      renderCountries('');
      setTimeout(function(){ countryFilter.focus(); }, 100);
    });

    countryFilter.addEventListener('input', function() { renderCountries(this.value); });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.form-group') || (!e.target.closest('#country-search') && !e.target.closest('#country-dropdown'))) {
        countryDropdown.style.display = 'none';
      }
    });
    // ── End Country Dropdown ─────────────────────────────────────

    // If journal pre-selected via URL param, scroll form into view
    const journalSel = document.getElementById('journal-select');
    if (journalSel && journalSel.value) {
      journalSel.dispatchEvent(new Event('change'));
      setTimeout(function(){ journalSel.closest('.sub-form-section')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 400);
    }

    // Add-on services — injected server-side, no CORS issues
    (function initAddons() {
      const addons = <%- JSON.stringify(typeof addonServices !== 'undefined' ? addonServices : []) %>;
      if (!addons || !addons.length) return;

      const section  = document.getElementById('addon-section');
      const grid     = document.getElementById('addon-grid');
      const input    = document.getElementById('addons-input');
      const totalBox = document.getElementById('addon-total');
      const totalAmt = document.getElementById('addon-total-amt');
      if (!section || !grid) return;
      section.style.display = 'block';

      const selected = {};

      function updateTotal() {
        const picked = addons.filter(function(a){ return selected[a.id]; });
        const sum = picked.reduce(function(s,a){ return s + a.price; }, 0);
        if (input) input.value = picked.length ? JSON.stringify(picked) : '';
        // total box hidden — shown in payment modal instead
        if (totalAmt) totalAmt.textContent = '₹' + sum.toLocaleString('en-IN');
      }

      addons.forEach(function(addon) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:12px;border:1.5px solid #e2e8f0;border-radius:12px;padding:12px 16px;background:#fff;cursor:pointer;text-align:left;transition:all 0.2s;font-family:inherit;width:100%;';
        btn.innerHTML = '<span style="font-size:0.88rem;font-weight:600;color:#334155;">' + addon.label + '</span>';
        btn.addEventListener('click', function() {
          selected[addon.id] = !selected[addon.id];
          if (selected[addon.id]) {
            btn.style.borderColor = '#22c55e'; btn.style.background = '#f0fdf4';
          } else {
            btn.style.borderColor = '#e2e8f0'; btn.style.background = '#fff';
          }
          updateTotal();
        });
        grid.appendChild(btn);
      });
    })();

    gsap.registerPlugin(ScrollTrigger);

    // Reveal animations
    gsap.utils.toArray('.gs-reveal').forEach(function(elem) {
      gsap.from(elem, {
        scrollTrigger: { trigger: elem, start: "top 85%" },
        y: 50, opacity: 0, duration: 1, ease: "power3.out"
      });
    });

    gsap.utils.toArray('.gs-reveal-up').forEach(function(elem) {
      gsap.from(elem, {
        scrollTrigger: { trigger: elem, start: "top 85%" },
        y: 30, opacity: 0, duration: 0.8, ease: "power2.out"
      });
    });

    // Form Inputs & Helpers
    const fileInput = document.getElementById('manuscript');

    // Dynamic Author Input
    const addAuthorBtn = document.getElementById('add-author-btn');
    const authorsContainer = document.getElementById('authors-container');
    let authorCount = 2;

    if (addAuthorBtn && authorsContainer) {
      addAuthorBtn.addEventListener('click', function () {
        authorCount++;
        const newGroup = document.createElement('div');
        newGroup.className = 'author-input-group';
        newGroup.style.marginBottom = '16px';
        newGroup.style.display = 'flex';
        newGroup.style.gap = '16px';
        newGroup.style.position = 'relative';

        const inputContainer = document.createElement('div');
        inputContainer.style.position = 'relative';
        inputContainer.style.flex = '1';

        const input = document.createElement('input');
        input.type = 'text';
        input.id = 'author_name_' + authorCount;
        input.name = 'author_names[]';
        input.className = 'form-control';
        input.placeholder = ' ';

        const label = document.createElement('label');
        label.htmlFor = 'author_name_' + authorCount;
        label.className = 'form-label';
        label.textContent = 'Author Name ' + authorCount;

        inputContainer.appendChild(input);
        inputContainer.appendChild(label);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.style.padding = '0 20px';
        removeBtn.style.background = 'rgba(239, 68, 68, 0.1)';
        removeBtn.style.border = '1px solid rgba(239, 68, 68, 0.3)';
        removeBtn.style.color = '#ef4444';
        removeBtn.style.borderRadius = '12px';
        removeBtn.style.cursor = 'pointer';
        removeBtn.style.transition = '0.3s';
        removeBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';

        removeBtn.onmouseover = function () { this.style.background = 'rgba(239, 68, 68, 0.2)'; };
        removeBtn.onmouseout = function () { this.style.background = 'rgba(239, 68, 68, 0.1)'; };

        removeBtn.onclick = function () {
          newGroup.remove();
        };

        newGroup.appendChild(inputContainer);
        newGroup.appendChild(removeBtn);
        authorsContainer.appendChild(newGroup);
      });
    }

    // Drag & Drop
    const manuscriptDrop = document.getElementById('manuscript-drop');
    if (manuscriptDrop && fileInput) {
      ['dragenter', 'dragover'].forEach(eventName => {
        manuscriptDrop.addEventListener(eventName, e => {
          e.preventDefault();
          manuscriptDrop.style.borderColor = 'var(--primary)';
          manuscriptDrop.style.background = 'rgba(37,99,235,0.05)';
        }, false);
      });

      ['dragleave', 'dragend', 'drop'].forEach(eventName => {
        manuscriptDrop.addEventListener(eventName, e => {
          e.preventDefault();
          manuscriptDrop.style.borderColor = '#cbd5e1';
          manuscriptDrop.style.background = 'var(--bg-light)';
        }, false);
      });

      manuscriptDrop.addEventListener('drop', e => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
          fileInput.files = files;
          fileInput.dispatchEvent(new Event('change'));
        }
      });
    }

    // Display selected file name and perform instant validation
    const fileNameDisplay = document.getElementById('file-name-display');

    if (fileInput && fileNameDisplay) {
      fileInput.addEventListener('change', function (e) {
        if (this.files && this.files.length > 0) {
          const file = this.files[0];
          const fileExt = file.name.split('.').pop().toLowerCase();
          const allowedExts = ['pdf', 'doc', 'docx'];
          
          if (!allowedExts.includes(fileExt)) {
            showError('Invalid file type! Only PDF, DOC, and DOCX files are allowed.');
            fileInput.value = '';
            fileNameDisplay.style.display = 'none';
            return;
          }
          
          if (file.size > 10 * 1024 * 1024) {
            showError('File size is too large! Maximum limit is 10MB.');
            fileInput.value = '';
            fileNameDisplay.style.display = 'none';
            return;
          }

          fileNameDisplay.style.display = 'block';
          fileNameDisplay.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#10b981; margin-right:6px;"></i> Selected: ' + file.name + ' (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB)';
        } else {
          fileNameDisplay.style.display = 'none';
        }
      });
    }

    // Modal Control Helpers
    const loadingOverlay = document.getElementById('loading-modal-overlay');
    const loadingTitle = document.getElementById('loading-title');
    const loadingMessage = document.getElementById('loading-message');
    const loadingProgressContainer = document.getElementById('loading-progress-container');
    const loadingProgressBar = document.getElementById('loading-progress-bar');
    const loadingPercentage = document.getElementById('loading-percentage');

    const successOverlay = document.getElementById('success-modal-overlay');
    const successSubId = document.getElementById('success-sub-id');
    const successPaperTitle = document.getElementById('success-paper-title');
    const successJournalName = document.getElementById('success-journal-name');
    
    const errorOverlay = document.getElementById('error-modal-overlay');
    const errorModalMessage = document.getElementById('error-modal-message');

    function showError(message, detail) {
      errorModalMessage.innerText = message || 'An unexpected error occurred. Please try again.';
      const detailBox = document.getElementById('error-detail-box');
      if (detail && detailBox) {
        detailBox.style.display = 'block';
        detailBox.innerText = detail;
      } else if (detailBox) {
        detailBox.style.display = 'none';
      }
      errorOverlay.classList.add('active');
    }

    // Dismiss buttons
    document.getElementById('close-success-btn').addEventListener('click', () => {
      successOverlay.classList.remove('active');
    });
    document.getElementById('close-error-btn').addEventListener('click', () => {
      errorOverlay.classList.remove('active');
    });

    // Payment button handlers
    document.getElementById('skip-payment-btn') && document.getElementById('skip-payment-btn').addEventListener('click', function() {
      successOverlay.classList.remove('active');
    });

    document.getElementById('pay-smepay-btn') && document.getElementById('pay-smepay-btn').addEventListener('click', async function() {
      if (!window._paymentSubmissionId) return;
      try {
        const res = await fetch('https://api.scripthive.org/api/payments/smepay/create-order', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ invoiceId: null, submissionId: window._paymentSubmissionId, amount: window._paymentAmount, currency: 'INR', addons: window._paymentAddons })
        });
        const data = await res.json();
        if (data.paymentUrl) window.location.href = data.paymentUrl;
        else alert('Payment initiation failed. Please try again.');
      } catch(e) { alert('Network error. Please try again.'); }
    });

    document.getElementById('pay-razorpay-btn') && document.getElementById('pay-razorpay-btn').addEventListener('click', async function() {
      if (!window._paymentSubmissionId) return;
      try {
        const res = await fetch('https://api.scripthive.org/api/payments/razorpay/create-order', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ invoiceId: null, submissionId: window._paymentSubmissionId, amount: window._paymentAmount, currency: 'INR' })
        });
        const data = await res.json();
        const orderId = data.orderId || (data.data && data.data.orderId);
        const keyId = data.keyId || (data.data && data.data.keyId) || '';
        if (orderId && window.Razorpay) {
          const rzp = new window.Razorpay({
            key: keyId,
            amount: window._paymentAmount * 100,
            currency: 'INR',
            order_id: orderId,
            name: 'ScriptHive Publication',
            description: 'Add-On Services',
            handler: function(resp) { successOverlay.classList.remove('active'); alert('Payment successful! Transaction ID: ' + resp.razorpay_payment_id); },
            prefill: {}
          });
          rzp.open();
        } else { alert('Payment initiation failed.'); }
      } catch(e) { alert('Network error. Please try again.'); }
    });

    document.getElementById('pay-paypal-btn') && document.getElementById('pay-paypal-btn').addEventListener('click', async function() {
      if (!window._paymentSubmissionId) return;
      try {
        const amtUsd = parseFloat((window._paymentAmount / 83).toFixed(2));
        const res = await fetch('https://api.scripthive.org/api/payments/paypal/create-order', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ invoiceId: null, submissionId: window._paymentSubmissionId, amount: amtUsd, currency: 'USD' })
        });
        const data = await res.json();
        if (data.approvalUrl) window.location.href = data.approvalUrl;
        else alert('PayPal payment initiation failed.');
      } catch(e) { alert('Network error. Please try again.'); }
    });

    let currentSubmissionDetails = null;

    // AJAX Form submission
    const form = document.getElementById('paper-submit-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        // 1. Client-Side Field Validations
        const authorName = document.getElementById('author-name').value.trim();
        const authorEmail = document.getElementById('author-email').value.trim();
        const journal = document.getElementById('journal-select').value;
        const paperTitle = document.getElementById('paper-title').value.trim();
        const abstract = document.getElementById('abstract').value.trim();
        const keywords = document.getElementById('keywords').value.trim();
        const declaration = document.getElementById('declaration').checked;

        if (!authorName || !authorEmail || !journal || !paperTitle || !abstract || !keywords) {
          showError('Please fill out all marked fields (*) before submitting.');
          return;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(authorEmail)) {
          showError('Please provide a valid email address.');
          return;
        }

        if (!fileInput.files || fileInput.files.length === 0) {
          showError('Please upload your manuscript file (.pdf, .doc, or .docx).');
          return;
        }

        if (!declaration) {
          showError('You must agree to the publication ethics and guidelines to submit.');
          return;
        }

        // 2. Initialize Loading Overlay
        loadingTitle.innerText = 'Submitting Manuscript';
        loadingMessage.innerText = 'Initializing connection and sanitizing manuscript...';
        loadingProgressContainer.style.display = 'block';
        loadingProgressBar.style.width = '0%';
        loadingPercentage.innerText = '0%';
        loadingOverlay.classList.add('active');

        // Prepare FormData
        const formData = new FormData(form);

        // 3. Perform AJAX Request with detailed progress tracking!
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/submit-paper', true);

        // Track upload progress
        xhr.upload.addEventListener('progress', function (e) {
          if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            
            if (percent < 99) {
              loadingProgressBar.style.width = percent + '%';
              loadingPercentage.innerText = percent + '%';
              loadingMessage.innerText = 'Uploading manuscript file... (' + (e.loaded / (1024 * 1024)).toFixed(2) + 'MB / ' + (e.total / (1024 * 1024)).toFixed(2) + 'MB)';
            } else {
              // Upload finished, now processing on server
              loadingProgressBar.style.width = '99%';
              loadingPercentage.innerText = '99%';
              loadingTitle.innerText = 'Processing Submission';
              loadingMessage.innerText = 'Sending confirmation emails and securing database entry...';
            }
          }
        });

        // Track load end
        xhr.onload = function () {
          loadingOverlay.classList.remove('active');
          
          let response = {};
          try {
            response = JSON.parse(xhr.responseText);
          } catch (e) {
            response = { status: 'error', message: 'An unexpected response was received from the server.' };
          }

          if (xhr.status === 200 && response.status === 'success') {
            // Save submission details for receipt download
            currentSubmissionDetails = response;

            // Populate success modal
            successSubId.innerText = response.submission_id;
            successPaperTitle.innerText = response.paper_title;
            successJournalName.innerText = response.journal;

            // Show payment section if addons selected
            const addonsRaw = document.getElementById('addons-input');
            const countryVal = document.getElementById('author-country') ? document.getElementById('author-country').value : 'India';
            const isIndia = countryVal === 'India' || countryVal === '';
            let selectedAddons = [];
            try { if (addonsRaw && addonsRaw.value) selectedAddons = JSON.parse(addonsRaw.value); } catch(e) {}

            if (selectedAddons.length > 0) {
              const total = selectedAddons.reduce(function(s,a){ return s + a.price; }, 0);
              const paySection = document.getElementById('payment-section');
              const receiptDoneBtns = document.getElementById('receipt-done-btns');
              if (paySection) {
                document.getElementById('payment-amount-display').textContent = isIndia ? ('₹' + total.toLocaleString('en-IN')) : ('$' + (total / 83).toFixed(2));
                document.getElementById('payment-addons-list').textContent = selectedAddons.map(function(a){ return a.label; }).join(', ');
                if (isIndia) {
                  document.getElementById('inr-payment-methods').style.display = 'block';
                  document.getElementById('usd-payment-methods').style.display = 'none';
                } else {
                  document.getElementById('inr-payment-methods').style.display = 'none';
                  document.getElementById('usd-payment-methods').style.display = 'block';
                }
                paySection.style.display = 'block';
                if (receiptDoneBtns) receiptDoneBtns.style.display = 'none';
              }
              // Store for payment
              window._paymentSubmissionId = response.submission_id;
              window._paymentAmount = total;
              window._paymentCurrency = isIndia ? 'INR' : 'USD';
              window._paymentAddons = selectedAddons;
            }

            // Show Success Modal
            successOverlay.classList.add('active');

            // Reset form
            form.reset();
            if (fileNameDisplay) fileNameDisplay.style.display = 'none';
            
            // Clean up any extra author fields added dynamically
            const dynamicAuthorGroups = document.querySelectorAll('#authors-container .author-input-group');
            dynamicAuthorGroups.forEach((group, index) => {
              if (index >= 0) group.remove(); // keep only original inputs
            });
          } else {
            const errMsg = response.message || 'Failed to submit manuscript. Please try again.';
            const errDetail = xhr.status !== 200 ? `HTTP ${xhr.status}` : undefined;
            showError(errMsg, errDetail);
          }
        };

        xhr.onerror = function () {
          loadingOverlay.classList.remove('active');
          showError('A network error occurred. Please check your internet connection.');
        };

        xhr.send(formData);
      });
    }

    // 4. Client-Side Premium PDF Generator (jsPDF Integration)
    const downloadBtn = document.getElementById('download-receipt-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function () {
        if (!currentSubmissionDetails) return;

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({
          orientation: 'portrait',
          unit: 'mm',
          format: 'a4'
        });

        const { submission_id, timestamp, author_name, email, paper_title, journal, review_timeline } = currentSubmissionDetails;

        // Elegant branding border & background styling
        doc.setFillColor(15, 23, 42); // Navy primary
        doc.rect(0, 0, 210, 40, 'F');

        // ScriptHive Branding Header
        doc.setTextColor(255, 255, 255);
        doc.setFont('Helvetica', 'bold');
        doc.setFontSize(22);
        doc.text('SCRIPTHIVE PUBLICATION', 20, 18);
        
        doc.setTextColor(251, 191, 36); // Amber secondary
        doc.setFont('Helvetica', 'normal');
        doc.setFontSize(10);
        doc.text('OFFICIAL MANUSCRIPT SUBMISSION RECEIPT', 20, 26);
        
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(8);
        doc.text('Date: ' + timestamp, 150, 26);

        // Core Submission Invoice Details
        doc.setTextColor(15, 23, 42);
        doc.setFont('Helvetica', 'bold');
        doc.setFontSize(14);
        doc.text('Submission Metadata', 20, 55);

        // Draw decorative thin rule
        doc.setDrawColor(226, 232, 240);
        doc.setLineWidth(0.5);
        doc.line(20, 58, 190, 58);

        // Metadata grid table-like structure
        const gridData = [
          ['Submission ID', submission_id],
          ['Primary Author', author_name],
          ['Contact Email', email],
          ['Target Journal', journal],
          ['Submission Date', timestamp],
          ['Review Timeline', review_timeline],
          ['Status', 'Submitted under Peer Review']
        ];

        doc.setFont('Helvetica', 'normal');
        doc.setFontSize(10);

        let currentY = 68;
        gridData.forEach(row => {
          doc.setFont('Helvetica', 'bold');
          doc.setTextColor(100, 116, 139);
          doc.text(row[0] + ':', 20, currentY);

          doc.setFont('Helvetica', 'normal');
          doc.setTextColor(15, 23, 42);
          
          if (row[0] === 'Target Journal' || row[0] === 'Submission ID') {
            doc.setFont('Helvetica', 'bold');
          }
          
          const textVal = row[1];
          const splitText = doc.splitTextToSize(textVal, 120);
          doc.text(splitText, 70, currentY);

          currentY += (splitText.length * 5) + 3;
        });

        // Paper Title Section
        currentY += 5;
        doc.setFont('Helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(15, 23, 42);
        doc.text('Manuscript Title', 20, currentY);
        
        currentY += 3;
        doc.line(20, currentY, 190, currentY);
        
        currentY += 8;
        doc.setFont('Helvetica', 'oblique');
        doc.setFontSize(11);
        doc.setTextColor(30, 41, 59);
        
        const splitTitle = doc.splitTextToSize('"' + paper_title + '"', 170);
        doc.text(splitTitle, 20, currentY);

        currentY += (splitTitle.length * 6) + 10;

        // Structured Info Callout box
        doc.setFillColor(248, 250, 252);
        doc.setDrawColor(226, 232, 240);
        doc.rect(20, currentY, 170, 32, 'FD');

        doc.setFont('Helvetica', 'bold');
        doc.setFontSize(9.5);
        doc.setTextColor(29, 78, 216);
        doc.text('Important Information for Authors:', 24, currentY + 7);

        doc.setFont('Helvetica', 'normal');
        doc.setFontSize(8.5);
        doc.setTextColor(71, 85, 105);
        
        const termsText = [
          '• Your manuscript has entered our rigorous double-blind peer review process.',
          '• The editorial board will complete the credential evaluation within 7 to 15 working days.',
          '• For any questions or updates, please contact editorial support at info@scripthive.org.'
        ];
        
        let termsY = currentY + 13;
        termsText.forEach(term => {
          doc.text(term, 24, termsY);
          termsY += 5;
        });

        // Bottom Footer
        doc.setFont('Helvetica', 'bold');
        doc.setFontSize(9);
        doc.setTextColor(100, 116, 139);
        doc.text('Thank you for choosing ScriptHive to publish your valuable research.', 20, 275);
        
        doc.setFont('Helvetica', 'normal');
        doc.setFontSize(8);
        doc.text('ScriptHive Academic Publication Portal — www.scripthive.org', 20, 280);

        // Save PDF receipt
        doc.save('ScriptHive_Receipt_' + submission_id + '.pdf');
      });
    }
  });
</script>

