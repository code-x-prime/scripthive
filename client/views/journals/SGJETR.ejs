            <div class="sb-actions">
              <a href="/submit?journal=SGJETR" class="j-btn j-btn-primary"><i class="fa-solid fa-paper-plane"></i> Submit Paper</a>
              <a href="/guidelines" class="j-btn j-btn-outline-dark"><i class="fa-solid fa-scroll"></i> Author Guidelines</a>
            </div>
          </div>
        </div>
      </div>

      <!-- TRUST INDICATORS -->
      <div class="trust-section gs-reveal-up">
        <div class="trust-grid">
          <div class="trust-card"><i class="fa-solid fa-receipt"></i>
            <h4>ISSN Registered</h4>
          </div>
          <div class="trust-card"><i class="fa-solid fa-microscope" style="color:var(--brand-shield);"></i>
            <h4>Peer Reviewed</h4>
          </div>
          <div class="trust-card"><i class="fa-solid fa-scale-balanced" style="color:var(--gold);"></i>
            <h4>Ethical Publishing</h4>
          </div>
          <div class="trust-card"><i class="fa-solid fa-lock-open" style="color:#8b5cf6;"></i>
            <h4>Open Access</h4>
          </div>
          <div class="trust-card"><i class="fa-solid fa-fingerprint" style="color:#ec4899;"></i>
            <h4>DOI Supported</h4>
          </div>
          <div class="trust-card"><i class="fa-solid fa-calendar-check" style="color:#14b8a6;"></i>
            <h4>Quarterly Pub.</h4>
          </div>
        </div>
      </div>

      <!-- FINAL CTA -->
      <div class="cta-banner gs-reveal">
        <div class="cta-content">
          <h2>Ready to Publish Your Research?</h2>
          <p>Submit your manuscript to SGJETR and share your technological innovations with the global academic community. Fast, transparent, and rigorous peer review guaranteed.</p>
          <div class="cta-buttons">
            <a href="/submit?journal=SGJETR" class="j-btn j-btn-white"><i class="fa-solid fa-file-arrow-up"></i> Submit Paper</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      gsap.registerPlugin(ScrollTrigger);

      // Reveal animations
      gsap.utils.toArray('.gs-reveal').forEach(function (elem) {
        gsap.from(elem, {
          scrollTrigger: { trigger: elem, start: "top 85%" },
          y: 50, opacity: 0, duration: 1, ease: "power3.out"
        });
      });

      gsap.utils.toArray('.gs-reveal-up').forEach(function (elem) {
        gsap.from(elem, {
          scrollTrigger: { trigger: elem, start: "top 85%" },
          y: 30, opacity: 0, duration: 0.8, ease: "power2.out"
        });
      });

      // Smart Sticky Nav: Freeze → Unfreeze + Re-animate
      (function () {
        var jNav = document.querySelector('.j-nav');
        if (!jNav) return;

        var sentinel = document.createElement('div');
        sentinel.setAttribute('aria-hidden', 'true');
        sentinel.style.cssText = 'height:1px;width:100%;pointer-events:none;visibility:hidden;';
        jNav.parentNode.insertBefore(sentinel, jNav);

        var hasPassedOnce = false;

        var navObserver = new IntersectionObserver(function (entries) {
          var entry = entries[0];
          var aboveViewport = entry.boundingClientRect.top < 0;

          if (!entry.isIntersecting && aboveViewport) {
            jNav.classList.add('is-stuck');
            hasPassedOnce = true;
          } else if (entry.isIntersecting && hasPassedOnce) {
            jNav.classList.remove('is-stuck');
            gsap.killTweensOf(jNav);
            gsap.fromTo(jNav,
              { y: 30, opacity: 0 },
              { y: 0, opacity: 1, duration: 0.6, ease: 'power2.out' }
            );
          }
        }, {
          threshold: 0,
          rootMargin: '-80px 0px 0px 0px'
        });

        navObserver.observe(sentinel);

        window.addEventListener('pagehide', function () {
          navObserver.disconnect();
        }, { once: true });
      })();

      // Simple sticky nav highlighting
      const sections = document.querySelectorAll('.c-section');
      const navLinks = document.querySelectorAll('.j-nav-list a');

      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
          const sectionTop = section.offsetTop;
          if (pageYOffset >= sectionTop - 150) {
            current = section.getAttribute('id');
          }
        });

        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href').includes(current) && current !== '') {
            link.classList.add('active');
          }
        });
      });

      // APPLY FOR EDITORIAL BOARD MODAL CONTROLLER & ANIMATIONS
      (function() {
        const modal = document.getElementById('applyBoardModal');
        const backdrop = document.getElementById('modalBackdrop');
        const dialog = modal.querySelector('.glass-modal-dialog');
        const openButtons = document.querySelectorAll('[data-bs-toggle="modal"][data-bs-target="#applyBoardModal"]');
        const closeButton = document.getElementById('btnCloseModal');
        const successCloseButton = document.getElementById('btnSuccessDone');
        
        let particleAnimationId = null;

        function openModal() {
          modal.classList.add('show');
          backdrop.classList.add('show');
          document.body.style.overflow = 'hidden';

          gsap.fromTo(dialog, 
            { scale: 0.82, rotateX: 12, rotateY: -5, y: 60, opacity: 0 },
            { scale: 1, rotateX: 0, rotateY: 0, y: 0, opacity: 1, duration: 0.65, ease: "back.out(1.2)", clearProps: "transform" }
          );

          gsap.fromTo(backdrop,
            { opacity: 0 },
            { opacity: 1, duration: 0.4 }
          );

          startParticles();
        }

        function closeModal() {
          gsap.to(dialog, {
            scale: 0.85,
            rotateX: -8,
            y: 40,
            opacity: 0,
            duration: 0.35,
            ease: "power2.in",
            onComplete: () => {
              modal.classList.remove('show');
              document.body.style.overflow = '';
              stopParticles();
              
              const successScreen = document.getElementById('successScreen');
              if (successScreen.classList.contains('show')) {
                successScreen.classList.remove('show');
                document.getElementById('editorialApplyForm').reset();
                
                document.getElementById('resumeFileDetails').style.display = 'none';
                document.getElementById('resumeDropzone').style.borderColor = '';
                document.getElementById('photoPreviewImage').style.display = 'none';
                document.getElementById('photoPreviewImage').src = '';
                document.getElementById('photoPreviewWrapper').querySelector('i').style.display = 'block';
              }
            }
          });

          gsap.to(backdrop, {
            opacity: 0,
            duration: 0.3,
            onComplete: () => {
              backdrop.classList.remove('show');
            }
          });
        }

        openButtons.forEach(btn => btn.addEventListener('click', (e) => {
          e.preventDefault();
          openModal();
        }));

        closeButton.addEventListener('click', closeModal);
        successCloseButton.addEventListener('click', closeModal);
        backdrop.addEventListener('click', closeModal);

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal.classList.contains('show')) {
            closeModal();
          }
        });

        const glowPoint = document.getElementById('modalGlowPoint');
        const modalContent = modal.querySelector('.glass-modal-content');
        
        modalContent.addEventListener('mousemove', (e) => {
          const rect = modalContent.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          gsap.to(glowPoint, {
            left: x,
            top: y,
            duration: 0.25,
            ease: "power1.out"
          });
        });

        const canvas = document.getElementById('modal-particles-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        
        function resizeCanvas() {
          canvas.width = modalContent.clientWidth;
          canvas.height = modalContent.clientHeight;
        }

        class Particle {
          constructor() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.radius = Math.random() * 2 + 1;
            this.vx = (Math.random() - 0.5) * 0.4;
            this.vy = (Math.random() - 0.5) * 0.4;
            this.color = Math.random() > 0.6 ? 'rgba(251, 191, 36, 0.25)' : 'rgba(37, 99, 235, 0.2)';
          }

          update() {
            this.x += this.vx;
            this.y += this.vy;

            if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
            if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
          }

          draw() {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fillStyle = this.color;
            ctx.fill();
          }
        }

        function startParticles() {
          resizeCanvas();
          particles = [];
          for (let i = 0; i < 40; i++) {
            particles.push(new Particle());
          }
          animateParticles();
        }

        function stopParticles() {
          if (particleAnimationId) {
            cancelAnimationFrame(particleAnimationId);
            particleAnimationId = null;
          }
        }

        function animateParticles() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          particles.forEach(p => {
            p.update();
            p.draw();
          });

          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 80) {
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(255, 255, 255, ${0.05 * (1 - dist/80)})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
              }
            }
          }

          particleAnimationId = requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', () => {
          if (modal.classList.contains('show')) {
            resizeCanvas();
          }
        });

        const resumeDropzone = document.getElementById('resumeDropzone');
        const resumeInput = document.getElementById('ebResume');
        const resumeFileDetails = document.getElementById('resumeFileDetails');
        const resumeFileName = document.getElementById('resumeFileName');

        ['dragenter', 'dragover'].forEach(eventName => {
          resumeDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            resumeDropzone.classList.add('dragover');
          }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
          resumeDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            resumeDropzone.classList.remove('dragover');
          }, false);
        });

        resumeDropzone.addEventListener('drop', (e) => {
          const dt = e.dataTransfer;
          const files = dt.files;
          if (files.length) {
            resumeInput.files = files;
            handleResumeSelect(files[0]);
          }
        });

        resumeDropzone.addEventListener('click', () => {
          resumeInput.click();
        });

        resumeInput.addEventListener('change', (e) => {
          if (resumeInput.files.length) {
            handleResumeSelect(resumeInput.files[0]);
          }
        });

        function handleResumeSelect(file) {
          const validTypes = ['.pdf', '.doc', '.docx'];
          const fileExtension = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
          
          if (!validTypes.includes(fileExtension)) {
            shakeElement(resumeDropzone);
            alert('Invalid file format. Please upload PDF, DOC, or DOCX only.');
            resumeInput.value = '';
            resumeFileDetails.style.display = 'none';
            return;
          }

          if (file.size > 10 * 1024 * 1024) {
            shakeElement(resumeDropzone);
            alert('File exceeds 10MB limit.');
            resumeInput.value = '';
            resumeFileDetails.style.display = 'none';
            return;
          }

          resumeFileName.textContent = `${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
          resumeFileDetails.style.display = 'flex';
          
          gsap.fromTo(resumeFileDetails, 
            { scale: 0.9, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.3 }
          );
        }

        const photoInput = document.getElementById('ebPhoto');
        const photoPreviewImage = document.getElementById('photoPreviewImage');
        const photoPreviewWrapper = document.getElementById('photoPreviewWrapper');
        const cameraIcon = photoPreviewWrapper.querySelector('i');

        photoInput.addEventListener('change', () => {
          if (photoInput.files.length) {
            const file = photoInput.files[0];
            const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
            
            if (!validTypes.includes(file.type)) {
              shakeElement(photoPreviewWrapper.parentElement);
              alert('Please select a valid image file (JPG, JPEG, PNG).');
              photoInput.value = '';
              return;
            }

            if (file.size > 4 * 1024 * 1024) {
              shakeElement(photoPreviewWrapper.parentElement);
              alert('Image exceeds 4MB limit.');
              photoInput.value = '';
              return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
              photoPreviewImage.src = e.target.result;
              photoPreviewImage.style.display = 'block';
              cameraIcon.style.display = 'none';

              gsap.fromTo(photoPreviewImage,
                { scale: 0.7, opacity: 0 },
                { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(1.5)" }
              );
            };
            reader.readAsDataURL(file);
          }
        });

        function shakeElement(element) {
          element.classList.add('shake-error');
          setTimeout(() => element.classList.remove('shake-error'), 600);
        }

        const form = document.getElementById('editorialApplyForm');
        const btnSubmit = document.getElementById('btnSubmitApp');
        const btnSpinner = btnSubmit.querySelector('.spinner-border-glass');

        form.addEventListener('submit', (e) => {
          e.preventDefault();

          let hasErrors = false;

          const requiredInputs = form.querySelectorAll('.glass-input[required]');
          requiredInputs.forEach(input => {
            if (!input.value.trim()) {
              shakeElement(input);
              hasErrors = true;
            } else if (input.type === 'email') {
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailRegex.test(input.value)) {
                shakeElement(input);
                hasErrors = true;
              }
            }
          });

          if (!resumeInput.files.length) {
            shakeElement(resumeDropzone);
            hasErrors = true;
          }
          if (!photoInput.files.length) {
            shakeElement(photoPreviewWrapper.parentElement);
            hasErrors = true;
          }

          if (hasErrors) return;

          btnSubmit.setAttribute('disabled', 'true');
          btnSpinner.style.display = 'inline-block';
          btnSubmit.querySelector('span').textContent = 'Uploading Assets...';

          const formData = new FormData(form);

          fetch('/api/editorial-board/apply', {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              document.getElementById('successQueryId').textContent = data.application_id;
              
              const successScreen = document.getElementById('successScreen');
              successScreen.classList.add('show');
              
              gsap.fromTo(successScreen.querySelector('.success-checkmark-wrapper'),
                { scale: 0.3, opacity: 0 },
                { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.5)" }
              );
            } else {
              alert(data.message || 'There was an issue processing your submission. Please try again.');
            }
          })
          .catch(err => {
            console.error('AJAX Error:', err);
            alert('A connection error occurred. Please verify your internet and try again.');
          })
          .finally(() => {
            btnSubmit.removeAttribute('disabled');
            btnSpinner.style.display = 'none';
            btnSubmit.querySelector('span').textContent = '🚀 Submit Application';
          });
        });
      })();
    });
  </script>

